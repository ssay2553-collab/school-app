rules_version = '2';

/* =========================================================
   FIRESTORE RULES - EduEaz
========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(uid())) ?
          get(/databases/$(database)/documents/users/$(uid())) :
          (
            exists(/databases/$(database)/documents/userAuthMappings/$(uid())) &&
            get(/databases/$(database)/documents/userAuthMappings/$(uid())).data.userDocId is string &&
            exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/userAuthMappings/$(uid())).data.userDocId)) ?
            get(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/userAuthMappings/$(uid())).data.userDocId)) :
            null
          )
      );
    }

    function userData() {
      return userDoc() != null ? userDoc().data : null;
    }

    /* ===============================
       ROLE & PERMISSION CHECKS (Dynamic)
    =============================== */

 function isAdmin() {
  return userData() != null && (
    userData().get('role', '').lower() in ['admin', 'superadmin', 'super admin'] ||
    userData().get(['profile', 'role'], '').lower() in ['admin', 'superadmin', 'super admin'] ||
    userData().get('adminRole', '') != '' ||
    userData().get(['profile', 'adminRole'], '') != '' ||
    userData().get(['permissions', 'manage-users'], '') == 'full' ||
    userData().get(['permissions', 'manage-fees'], '') == 'full'
  );
}

   function isSuperAdmin() {
     return isAdmin() && ((userData().get('adminRole', '').lower() in [
         "proprietor", "proprietress", "manager", "headmaster",
         "headmistress", "administrator", "director", "accountant", "bursar", "admin", "super admin", "superadmin"
       ]) ||
       (userData().get(['profile', 'adminRole'], '').lower() in [
         "proprietor", "proprietress", "manager", "headmaster",
         "headmistress", "administrator", "director", "accountant", "bursar", "admin", "super admin", "superadmin"
       ])
     );
   }

    function getPermission(screen) {
      return userData() != null ?
        (
          (
            ("permissions" in userData() && screen in userData().permissions) ? userData().permissions[screen] :
            (("profile" in userData() && "permissions" in userData().profile && screen in userData().profile.permissions) ? userData().profile.permissions[screen] : "deny")
          ) is string ?
            (
              (("permissions" in userData() && screen in userData().permissions) ? userData().permissions[screen] :
              (("profile" in userData() && "permissions" in userData().profile && screen in userData().profile.permissions) ? userData().profile.permissions[screen] : "deny")).lower()
            ) :
            "deny"
        ) :
        "deny";
    }

  function hasPermission(screen, level) {
      return (isAdmin() || isStaff() || isTeacher()) &&
        (
      isSuperAdmin() ||
      hasScreenPermission(screen, level)
    );
}

function hasScreenPermission(screen, level) {
  return
    (getPermission(screen) == "full") ||
    (getPermission(screen) == "edit" && (level == "edit" || level == "view")) ||
    (getPermission(screen) == "view" && level == "view");
}
/* ===============================
       SCREEN PERMISSION HELPERS
       These functions map screens to their required permissions
    =============================== */

    function canManageFees() {
      return hasPermission('manage-fees', 'edit');
    }

    function canViewFees() {
      return hasPermission('manage-fees', 'view');
    }

    function canManageExpenditure() {
      return hasPermission('expenditure', 'edit');
    }

    function canViewExpenditure() {
      return hasPermission('expenditure', 'view');
    }

    function canManagePayroll() {
      return hasPermission('staff-payroll', 'edit');

    }


    function canManageFAQ() {
      return hasPermission('faq', 'edit');
    }


    function canManageTimetables() {
      return hasPermission('timetables', 'edit');
    }

    function canManageAcademicCalendar() {
      return hasPermission('academic-calendar', 'edit');
    }

    function canViewAttendance() {
      return hasPermission('attendance', 'view');
    }

    function canManageAttendance() {
      return isAdmin() || getPermission('attendance') == 'full' || getPermission('attendance') == 'edit';
    }

    function canViewAcademicRecords() {
      return hasPermission('academic-records', 'view');
    }

    function canManageAcademicRecords() {
      return hasPermission('academic-records', 'edit');
    }

    function canViewScores() {
      return hasPermission('scores', 'view');
    }

    function canManageScores() {
      return hasPermission('scores', 'edit');
    }

    function canViewBehavioralRecords() {
      return hasPermission('behavioral-records', 'view');
    }

    function canManageBehavioralRecords() {
      return hasPermission('behavioral-records', 'edit');
    }

    function canManageAssignments() {
      return hasPermission('assignments', 'edit');
    }

    function canViewAssignments() {
      return hasPermission('assignments', 'view');
    }


    // Financial permissions (for feeding and bus fee recording)
    function canManageFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit';
    }

    function canViewFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit' || getPermission('feeding') == 'view';
    }

    function canRecordBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit';
    }

    function canViewBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit' || getPermission('record-bus-fee') == 'view';
    }

    function canManageExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit';
    }

    function canViewExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-extra-classes') == 'view' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit' || getPermission('record-class-fee') == 'view';
    }

    function canManageSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit';
    }

    function canViewSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit' || getPermission('manage-sales') == 'view';
    }


    function isTeacher() {
      return userData() != null && (
        userData().get('role', '').lower() == 'teacher' ||
        userData().get(['profile', 'role'], '').lower() == 'teacher' ||
        userData().get('classTeacherOf', '') != '' ||
        userData().get(['profile', 'classTeacherOf'], '') != '' ||
        userData().get('classes', []).size() > 0 ||
        userData().get(['profile', 'classes'], []).size() > 0 ||
        userData().get('subjects', []).size() > 0 ||
        userData().get(['profile', 'subjects'], []).size() > 0 ||
        userData().get('assignedRoles', []).hasAny(['Class Teacher']) ||
        userData().get(['profile', 'assignedRoles'], []).hasAny(['Class Teacher'])
      );
    }

    function isStaff() {
      return userData() != null && (
        userData().get('role', '').lower() == 'staff' ||
        userData().get(['profile', 'role'], '').lower() == 'staff'
      );
    }

    function isStudent() {
      return userData() != null && (
        userData().get('role', '').lower() == 'student' ||
        userData().get(['profile', 'role'], '').lower() == 'student'
      );
    }

    function isParent() {
      return userData() != null && (
        userData().get('role', '').lower() == 'parent' ||
        userData().get(['profile', 'role'], '').lower() == 'parent'
      );
    }

function isParentOf(studentId) {
  return isSignedIn() && studentId in userData().childrenIds;
}

    function isClassTeacher(classId) {
      return isSignedIn() && (isTeacher() || isStaff()) && (
        userData().get('classTeacherOf', '') == classId ||
        userData().get(['profile', 'classTeacherOf'], '') == classId ||
        (classId in userData().get('classes', [])) ||
        (classId in userData().get(['profile', 'classes'], [])) ||
        (
          (userData().get('assignedRoles', []).hasAny(["Class Teacher"]) ||
           userData().get(['profile', 'assignedRoles'], []).hasAny(["Class Teacher"])) &&
          (
            userData().get('classTeacherOf', '') == classId ||
            userData().get(['profile', 'classTeacherOf'], '') == classId
          )
        )
      );
    }

    function canCreateNews() {
      return isAdmin() || (isTeacher() && userData() != null && userData().canCreateNews == true);
    }
     function canGenerateCode() {
      return isAdmin() || isTeacher();
    }

    function isEventOrganiser() {
      return isTeacher();
    }

        /* ===============================
           SIGNUP CODES
        =============================== */
        match /signupCodes/{codeId} {
          // 1. Allow verification (Step 1 of signup)
          // Restricting to limit <= 1 prevents anyone from listing/scraping all valid codes.
          // Both student.tsx and teacher.tsx use a query with a limit of 1.
          allow read: if request.query.limit <= 1;

          // 2. Allow Admins/Staff to manage codes
          allow create, delete: if canGenerateCode();

          // 3. Allow newly registered users to "claim" the code in their signup batch
          // Used by teacher.tsx (batch.update)
          allow update: if isSignedIn()
            // Ensure the code hasn't been used yet (handles missing field or false)
            && (!('used' in resource.data) || resource.data.used == false)
            // Ensure they are marking it as used by their own UID
            && request.resource.data.used == true
            && request.resource.data.usedBy == uid();
        }


    /* =========================================================================
       USERS COLLECTION
    ========================================================================= */

    match /userAuthMappings/{authUid} {
      allow read: if isSignedIn() && uid() == authUid;
      allow create: if isSignedIn() && uid() == authUid && request.resource.data.userDocId is string;
      allow update: if isSignedIn() && uid() == authUid && request.resource.data.userDocId == resource.data.userDocId;
      allow delete: if isSignedIn() && uid() == authUid;
    }

    match /users/{userId} {
      allow read: if (
          isSignedIn() && (
            isAdmin() ||
            uid() == userId ||
            (isTeacher() || isStaff()) && (
               resource.data.role == 'student' ||
               resource.data.role == 'parent' ||
               resource.data.role == 'teacher'
            ) ||
            (isParent() && userId in userData().childrenIds)
          )
        ) || (
          // Public verification (Used by student.tsx Step 1)
          // Allows checking if a signupCode exists before the user is logged in
          request.query.limit <= 1 &&
          resource.data.role == 'student' && (
            'parentLinkCode' in resource.data ||
            (resource.data.status == 'pending_activation' && 'signupCode' in resource.data)
          )
        );

      /* ===============================
         CREATE
      =============================== */
      allow create: if
        isSignedIn() &&
        uid() == userId &&
        (
          // Regular users (cannot assign permissions or admin roles)
          (
            request.resource.data.role in ['teacher', 'student', 'parent', 'guest'] &&
            'secretCode' in request.resource.data &&
            !('permissions' in request.resource.data) &&
            !('adminRole' in request.resource.data)
          )
          ||
          // Initial admin signup
          (
            request.resource.data.role == 'admin' &&
            existsAfter(
              /databases/$(database)/documents/adminRoles/$(request.resource.data.adminRole.lower())
            )
          )
        );

      /* ===============================
         UPDATE
      =============================== */

      allow update: if
          isSuperAdmin() ||
          hasPermission('manage-users', 'full')

          // Case 1: Activation of Bulk-Imported profile
          // Allows a new user to "claim" a record that was pre-created by an admin
          || (
            isSignedIn() &&
            resource.data.status == 'pending_activation' &&
            request.resource.data.status == 'active' &&
            request.resource.data.uid == uid()
          )

          // Case 2: User updating own profile
          || (
            isSignedIn() &&
            uid() == userId &&
            !request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasAny([
                'role',
                'adminRole',
                'uid',
                'isAnonymous',
                'createdAt',
                'permissions'
              ])
          )

      // Teacher changing student's class
      || (
        isTeacher() &&
        resource.data.role == 'student' &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['classId']) &&
        resource.data.classId in userData().classes
      )

      // Parent linking to student (maximum 2)
      || (
        isSignedIn() &&
        resource.data.role == 'student' &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['parentUids']) &&
        uid() in request.resource.data.parentUids &&
        (
          !('parentUids' in resource.data) ||
          resource.data.parentUids.size() < 2
        )
      )

      // Fee Management
      || (
        canManageFees() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'walletBalance',
            'otherBill',
            'otherPaid',
            'otherBalance',
            'admissionBalance',
            'ptaBalance',
            'maintenanceBalance',
            'booksBalance',
            'uniformBalance',
            'admissionBill',
            'ptaBill',
            'maintenanceBill',
            'booksBill',
            'uniformBill',
            'onDiscount',
            'discountAmount'
          ])
      )

      // Wallet updates by delegated staff
      || (
        (
          canManageFeeding() ||
          canRecordBusFee() ||
          canManageExtraClasses() ||
          canManageSales() ||
          getPermission('manage-users') == 'full'
        ) &&
        (
          isAdmin() ||
          ((isTeacher() || isStaff()) &&
            isClassTeacher(resource.data.classId))
        ) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['walletBalance'])
      )

      // Payroll
      || (
        canManagePayroll() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['salary'])
      )

      // Staff/Class Teacher editing student records
      || (
        (
          hasPermission('manage-users', 'edit') ||
          (
            (isTeacher() || isAdmin() || isStaff()) &&
            isClassTeacher(resource.data.classId)
          )
        ) &&
        (
          resource.data.role == 'student' ||
          resource.data.get(['profile', 'role'], '') == 'student'
        ) &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'adminRole',
            'uid',
            'isAnonymous',
            'createdAt',
            'permissions',
            'walletBalance',
            'salary',
            'parentUids',
            'parentLinkCode'
          ])
      );

  /* ===============================
     DELETE
  =============================== */

  allow delete: if isSuperAdmin();
}
    /* ===============================
       ADMIN ROLES UNIQUENESS
    =============================== */
   match /adminRoles/{roleName} {
     allow read: if isSignedIn();

     allow create: if isSignedIn()
       && request.resource.data.uid == uid()
       && request.resource.data.roleName == roleName
       // Ensure they are also creating their user doc in the same batch
       && existsAfter(/databases/$(database)/documents/users/$(uid()));

     allow update, delete: if isSuperAdmin();
   }

    /* ===============================
       FINANCE & PAYROLL
    =============================== */

   match /studentFeeRecords/{id} {

  allow read: if
      canViewFees()
      || canViewSales()
      || (
        isSignedIn() &&
        (
          (
            isParent() &&
            (
              id.split('_')[0] in userData().childrenIds ||
              (resource != null &&
               resource.data.studentUid in userData().childrenIds)
            )
          )
          ||
          (
            isStudent() &&
            (
              id.split('_')[0] == uid() ||
              (resource != null &&
               resource.data.studentUid == uid())
            )
          )
          ||
          (
            isTeacher() &&
            (
              resource == null ||
              isClassTeacher(resource.data.classId)
            )
          )
        )
      );

  allow write: if
      canManageFees()
      || canManageSales()
      || hasPermission('manage-users', 'full')
      || (
        isTeacher()
        && isClassTeacher(request.resource.data.classId)
        && (
          request.resource.data.adminUid == uid()
          || canManageFeeding()
          || canRecordBusFee()
          || canManageExtraClasses()
          || canManageSales()
        )
      );
}

    match /feePayments/{id} {

  allow read: if
      canViewFees()
      || (
        (
          canViewFeeding()
          || canViewBusFee()
          || canViewExtraClasses()
          || canViewSales()
        )
        &&
        (
          isAdmin()
          || (
            isTeacher() &&
            (
              resource == null ||
              isClassTeacher(resource.data.classId)
            )
          )
        )
      )
      || (
        isSignedIn()
        &&
        (
          (
            isParent()
            &&
            (
              resource == null ||
              resource.data.studentUid in userData().childrenIds
            )
          )
          ||
          (
            isStudent()
            &&
            (
              resource == null ||
              resource.data.studentUid == uid()
            )
          )
        )
      );

  allow write: if
      canManageFees()
      || (
        (
          canManageFeeding()
          || canRecordBusFee()
          || canManageExtraClasses()
          || canManageSales()
        )
        &&
        (
          isAdmin()
          ||
          (
            isTeacher()
            && isClassTeacher(request.resource.data.classId)
          )
        )
        &&
        request.resource.data.amount is number
      )
      || (
        isTeacher()
        && isClassTeacher(request.resource.data.classId)
        && request.resource.data.adminUid == uid()
        && request.resource.data.amount is number
      );

  allow delete: if canManageFees();
}

    match /expenditures/{id} {
      allow read: if canViewExpenditure();
      allow create: if canManageExpenditure() &&
        request.resource.data.status == 'open' &&
        request.resource.data.amount > 0;
      allow update: if canManageExpenditure() &&
        (resource.data.status == 'open' || request.resource.data.status == 'closed');
      allow delete: if false;
    }

   match /payroll/{id} {
      allow read, create, update, delete: if hasPermission('staff-payroll', 'edit') || (hasPermission('staff-payroll', 'view') && request.method == 'get');
    }
     /* ===============================
       TEACHER & STUDENT NOTES
    =============================== */
    match /teacher_notes/{noteId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /student_notes/{noteId} {
      allow read, write: if isSignedIn() && (isStudent() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    /* ===============================
       TEACHING & LEARNING MATERIALS (TLM)
    =============================== */
    match /tlms/{tlmId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    /* ===============================
       OTHER COLLECTIONS
    =============================== */

    match /news/{id} {
      allow read: if true;
      allow write: if canCreateNews();
    }

/* ===============================
       SCHOOL SETTINGS
    =============================== */
    match /school_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

     match /timetables/{classId} {
      allow read: if isSignedIn();
      allow write: if canManageTimetables() || isAdmin() || isClassTeacher(classId);
    }


    /* ===============================
       DIRECT MESSAGES COLLECTION & SUBCOLLECTION
    =============================== */
    match /directMessages/{chatId} {
      function isParticipant() {
        return isSignedIn()
          && (chatId.matches('^' + uid() + '_.*|.*_' + uid() + '$'));
      }

      allow read: if isAdmin() || isParticipant() || isTeacher();

      match /messages/{messageId} {
        allow read: if isAdmin() || isParticipant() || isTeacher();

        allow create: if
          isAdmin() || isTeacher()
          || (
            isParticipant()
            && request.resource.data.senderId == uid()
            && request.resource.data.createdAt is timestamp
          );

        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       CLASSES COLLECTION
    =============================== */
    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC CALENDAR
    =============================== */
    match /academic_calendar/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.visibility == 'all' ||
        (userData().role == 'teacher' && resource.data.visibility == 'teachers') ||
        ((userData().role == 'parent' || userData().role == 'student') && resource.data.visibility == 'parents')
      );
      allow create, update, delete: if canManageAcademicCalendar() || isAdmin() || isEventOrganiser();
    }

    /* ===============================
       CHATS COLLECTION (Admin-Parent)
    =============================== */
    match /chats/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    /* ===============================
       PERSONAL TIMETABLES
    =============================== */
    match /personal_timetables/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ===============================
       SUBJECTS COLLECTION
    =============================== */
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       ATTENDANCE COLLECTION
    =============================== */
    match /attendance/{id} {
      function getClassIdFromAttendanceId(attendanceId) {
        return attendanceId.split('_')[0];
      }

      allow read: if
      canViewAttendance() ||
        isAdmin()
        || ((isTeacher() || isStaff()) && (isClassTeacher(getClassIdFromAttendanceId(id)) || (resource != null && isClassTeacher(resource.data.classId))))
        || (isStudent() && resource != null && resource.data.classId == userData().classId)
        || (isParent() && resource != null && exists(/databases/$(database)/documents/users/$(uid())) && (resource.data.students.keys().hasAny(userData().get('childrenIds', []))));

      allow write: if canManageAttendance() || isAdmin() || (
        (isTeacher() || isStaff()) &&
        isClassTeacher(request.resource.data.classId) &&
        request.resource.data.classId == getClassIdFromAttendanceId(id) &&
        request.resource.data.date == id.split('_')[id.split('_').size() - 1] &&
        request.resource.data.markedBy == uid() &&
        request.resource.data.lastUpdated == request.time &&
        request.resource.data.students is map
      );
      allow delete: if canManageAttendance() || isAdmin();
    }

    match /attendanceSummary/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() || isStaff()) ||
        (isStudent() && id.split('_')[0] == uid()) ||
        (isParent() && id.split('_')[0] in userData().get('childrenIds', []))
      );
      allow write: if isAdmin() ||
        (isSignedIn() && (isTeacher() || isStaff()) &&
        (
          isClassTeacher(request.resource.data.classId) ||
          (resource != null && isClassTeacher(resource.data.classId))
        ) &&
        request.resource.data.lastUpdated == request.time &&
        (
          request.resource.data.classId == id.split('_')[0] ||
          request.resource.data.studentId == id.split('_')[0]
        )
      );
    }

    match /academicRecordsSummary/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) ||
        (isStudent() && id.split('_')[0] == uid()) ||
        (isParent() && id.split('_')[0] in userData().get('childrenIds', []))
      );
      allow write: if isAdmin() || ((isTeacher() || isStaff()) && canManageAcademicRecords());
    }

    /* ===============================
       BEHAVIORAL / PRESCHOOL RECORDS
    =============================== */
    match /behavioralRecords/{recordId} {
      // READ: Admins, Teachers of the class, or Parents of students in this record
      allow read: if isSignedIn() && (
        isAdmin() ||
        ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) ||
        (isParent() && resource != null && resource.data.studentIds.hasAny(userData().get('childrenIds', [])))
      );

        // WRITE: Admins or Teachers assigned to the class (or class teacher).
        // Require writes to record the actor and use server timestamp.
        allow create, update: if isSignedIn() && (
          isAdmin() ||
          (
            (isTeacher() || isStaff()) &&
            (
              // teacher is assigned to the class (membership) OR is the class teacher
              (request.resource.data.classId in userData().get('classes', [])) ||
              isClassTeacher(request.resource.data.classId) ||
              // allow updating existing record if the existing record's class lists this user as class teacher
              (resource != null && isClassTeacher(resource.data.classId))
            ) &&
            // ensure the actor is recorded and timestamp is server time
            request.resource.data.updatedBy == uid() &&
            request.resource.data.timestamp == request.time
          )
        );

        // Deletes only allowed by admins or class teachers of the existing record
        allow delete: if isSignedIn() && (
          isAdmin() ||
          ((isTeacher() || isStaff()) && resource != null && isClassTeacher(resource.data.classId))
        );
    }

    /* ===============================
       ASSIGNMENTS COLLECTION
    =============================== */
   match /assignments/{id} {
      allow read: if canViewAssignments() || isAdmin() || (
            resource != null && (
              resource.data.teacherId == uid() ||
              resource.data.teacherId == userDoc().id
            )
          ) || (isStudent() && resource != null && resource.data.classId == userData().classId) || isParent();

      // Creation: require teacher to be the actor and assigned to the class, and createdAt must be server time
      allow create: if canManageAssignments() || (
        (isTeacher() || isStaff()) &&
        request.resource.data.teacherId == uid() &&
        (request.resource.data.classId in userData().get('classes', [])) &&
        request.resource.data.createdAt == request.time
      );

      // Updates: allow if manager or teacher-owner; teacher must be the actor and either the new or existing class is one they teach
      allow update: if canManageAssignments() || (
        (isTeacher() || isStaff()) &&
        request.resource.data.teacherId == uid() &&
        (
          (request.resource.data.classId in userData().get('classes', [])) ||
          (resource != null && resource.data.classId in userData().get('classes', []))
        )
      );

      allow delete: if canManageAssignments() || isAdmin();
    }

     /* ===============================
            SUBMISSIONS COLLECTION
         =============================== */
         match /submissions/{submissionId} {
           allow read: if isSignedIn() && (
             isAdmin() ||
             isTeacher() || isStaff() ||
             (isStudent() && resource != null && resource.data.studentId == uid())
           );

           allow create: if isSignedIn() &&
             isStudent() &&
             request.resource.data.studentId == uid() &&
             // Validate that the timestamp is actually the server time
             request.resource.data.submittedAt == request.time &&
             // Ensure students cannot set grading fields on create
             // Only allow expected submission fields
             request.resource.data.keys().hasOnly([
               'submissionKey', 'assignmentId', 'assignmentTitle', 'assignmentCode', 'studentId', 'studentName',
               'type', 'classId', 'subjectId', 'teacherId', 'responses', 'contentHtml', 'fileUrl', 'fileName',
               'isLate', 'marked', 'submittedAt', 'note', 'noteId', 'status'
             ]) &&
             // Must not mark submissions as already marked
             (request.resource.data.marked == false || !request.resource.data.keys().hasAny(['marked']));

           allow update: if isSignedIn() && (
             isAdmin() ||
             ((isTeacher() || isStaff()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'marked', 'feedback', 'markedAt', 'questionScores']))
           );

           allow delete: if isAdmin();
         }

     /* ===============================
       NOTIFICATIONS COLLECTION
    =============================== */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientId == uid());
      allow create: if isAdmin() || isTeacher();
      allow update: if uid() == resource.data.recipientId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || uid() == resource.data.recipientId;
    }

    /* ===============================
       ACTIVITY LOGS
    =============================== */
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    /* ===============================
       GALLERY & METADATA
    =============================== */
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery_metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC YEARS
    =============================== */
    match /academicYears/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       NEWS CATEGORIES
    =============================== */
    match /newscategories/{id} {
      allow read: if true;
    }

    /* ===============================
       STUDENT GROUPS & MESSAGES
    =============================== */
    match /studentGroups/{groupId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || (isStudent() && uid() in resource.data.studentIds) || (isParent() && userData().childrenIds.hasAny(resource.data.studentIds));
      allow create: if isTeacher() && request.resource.data.teacherId == uid();
      allow update: if isTeacher() && resource.data.teacherId == uid();
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      match /messages/{messageId} {
        function isGroupMember() {
          return isAdmin() ||
            get(/databases/$(database)/documents/studentGroups/$(groupId)).data.teacherId == uid() ||
            uid() in get(/databases/$(database)/documents/studentGroups/$(groupId)).data.studentIds;
        }
        allow read: if isSignedIn() && isGroupMember();
        allow create: if isSignedIn() && isGroupMember() && request.resource.data.senderId == uid();
      }
    }

    /* ===============================
       GUEST TICKETS & MESSAGES
    =============================== */
    match /guestTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.guestUid == uid());
      allow update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/guestTickets/$(ticketId)).data.guestUid == uid());
        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       FAQS
    =============================== */
    match /faqs/{key} {
      allow read: if true;
      allow write: if canManageFAQ() || isAdmin();
    }

     /* ===============================
       SCORES & REPORTS
    =============================== */
    match /scores/{scoreId} {
      allow read: if canViewScores() || isAdmin() || ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) || (isStudent() && resource != null && uid() == resource.data.studentId) || (isParent() && resource != null && resource.data.studentId in userData().get('childrenIds', []));
      allow write: if canManageScores() || isAdmin() || ((isTeacher() || isStaff()) && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageScores() || isAdmin();
    }

    match /student-reports/{reportId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        canViewScores() ||
        canViewAcademicRecords() ||
        ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) ||
        (isStudent() && resource != null && uid() == resource.data.studentId) ||
        (isParent() && (isParentOf(reportId.split('_')[0]) || (resource != null && isParentOf(resource.data.studentId))))
      );
      allow write: if isAdmin() || canManageScores() || canManageAcademicRecords() || ((isTeacher() || isStaff()) && isClassTeacher(request.resource.data.classId));
      allow delete: if isAdmin() || canManageScores() || canManageAcademicRecords();
    }

/* ===============================
   ACADEMIC RECORDS
=============================== */
match /academicRecords/{recordId} {

  allow read: if isSignedIn() && (
    isAdmin() ||
    canViewAcademicRecords() ||
        ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) ||
        (isStudent() && resource != null && resource.data.classId == userData().classId) ||
        (isParent() && resource != null && resource.data.status == 'approved')
      );

      allow create, update: if isSignedIn() && (
        isAdmin() ||
        (
          (isTeacher() || isStaff()) &&
          (canManageAcademicRecords() || canManageScores()) &&
          // Validate teacher is assigned to this class
          (request.resource.data.classId in userData().get('classes', [])) &&
          // Validate teacher teaches this subject (Ensure 'subjects' exists on teacher doc)
          (request.resource.data.subject in userData().get('subjects', [])) &&
          // Ensure teacher field matches actor and timestamp is server time
          request.resource.data.teacherId == uid() &&
          request.resource.data.timestamp == request.time &&
          // Final safety check: behavioral data requires class teacher
          (
            !request.resource.data.get('containsBehavioralData', false) ||
            isClassTeacher(request.resource.data.classId)
          )
    )
  );

  allow delete: if isAdmin() || canManageAcademicRecords();
}



 /* ===============================
       AI & PEDAGOGY COLLECTIONS
    =============================== */
    match /ai_generations/{id} {
      // Teachers can read their own usage and log new generations
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /ai_searches/{id} {
      // Users can log their searches and read their history
      allow read, create: if isSignedIn() && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    match /pedagogy_vault/{id} {
      // Teachers can save and read their own lesson plans
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());

      // Students can read weekly plans for their class
      allow read: if isStudent() && resource.data.classLevel == userData().classId;

      // Allow updates if the teacher is editing their own saved plan
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    /* ===============================
       METADATA
    =============================== */
    match /metadata/schoolStats {
      allow read, write: if false;
    }

    /* ===============================
       NON-TEACHING STAFF
       Used for tracking non-teaching staff (drivers, cooks, security, etc.)
       =============================== */
    match /nonTeachingStaff/{staffId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
       }

    /* ===============================
       DAILY FINANCIALS
    =============================== */
    match /dailyFinancials/{id} {
      allow read: if canViewFeeding() || canViewBusFee() || canViewExtraClasses() || isAdmin()
        || (isTeacher() && (
             (resource != null && isClassTeacher(resource.data.classId)) ||
             (id.split('_')[0] == uid()) // fallback for student-specific docs if applicable
           ))
        || (isParent() && (id.split('_')[0] in userData().get('childrenIds', []) || (resource != null && resource.data.studentUid in userData().get('childrenIds', []))))
        || (isStudent() && (id.split('_')[0] == uid() || (resource != null && resource.data.studentUid == uid())));

      allow create: if isAdmin() || (
          (isTeacher() || isStaff()) && (
            // Must provide at least one numeric fee (non-negative)
            (
              (request.resource.data.feedingFee is number && request.resource.data.feedingFee >= 0) ||
              (request.resource.data.busFee is number && request.resource.data.busFee >= 0) ||
              (request.resource.data.extraClassesFee is number && request.resource.data.extraClassesFee >= 0)
            )
            // Document id must follow the convention: <studentUid>_<YYYY-MM-DD>
            && id == (request.resource.data.studentUid + "_" + request.resource.data.date)
            // Date must be ISO yyyy-mm-dd
            && (request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$'))
            // total may be updated via transforms (e.g. increment()); do not require numeric literal here
            // Ensure teacher/staff are creating records only for their class OR have explicit permissions
            && (
              isClassTeacher(request.resource.data.classId) ||
              canManageFeeding() ||
              canRecordBusFee() ||
              canManageExtraClasses()
            )
            // Ensure recordedByUid matches the authenticated user for non-admin creators
            && request.resource.data.recordedByUid == uid()
            // createdAt should be set server-side
            && request.resource.data.createdAt == request.time
          )
      );

      allow update: if isAdmin() || (
          (isTeacher() || isStaff()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'feedingPaid', 'feedingCollector', 'feedingFee',
            'busPaid', 'busCollector', 'busFee',
            'extraPaid', 'extraCollector', 'extraClassesFee',
            'total', 'disbursedAt', 'disbursedBy',
            'updatedAt', 'date', 'studentUid', 'studentName', 'classId', 'className',
            'recordedBy', 'recordedByUid', 'createdAt', 'otherFees', 'otherFeesDescription',
            'feedingPaidAt', 'busPaidAt', 'extraPaidAt'
          ]) && (
            // Feeding fields require feeding permission
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedingPaid', 'feedingCollector', 'feedingFee']) || canManageFeeding()) &&

            // Bus fields: allow class-teacher OR those with specific permissions
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['busPaid', 'busCollector', 'busFee']) ||
              canRecordBusFee() ||
              isClassTeacher(resource.data.classId)
            ) &&

            // Extra-classes fields: allow class-teacher OR those with specific permissions
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraPaid', 'extraCollector', 'extraClassesFee', 'disbursedAt', 'disbursedBy', 'extraPaidAt']) ||
              canManageExtraClasses() ||
              isClassTeacher(resource.data.classId)
            )
          )
      );

      allow delete: if isAdmin();
    }

    /* ===============================
       FALLBACK & CATCH-ALL
    =============================== */
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
