rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid()))
        : null;
    }

    function userData() {
      return userDoc() != null ? userDoc().data : null;
    }

    /* ===============================
       ROLE & PERMISSION CHECKS (Dynamic)
    =============================== */

    function isAdmin() {
      return userData() != null && (
        userData().role == "admin" ||
        (userData().get(['profile', 'role'], '') == 'admin')
      );
    }

    function isSuperAdmin() {
      return isAdmin() && (
        ("adminRole" in userData() && [
          "proprietor", "proprietress", "manager", "headmaster",
          "headmistress", "administrator", "director", "accountant", "bursar", "admin"
        ].hasAny([userData().adminRole.lower()])) ||
        ("profile" in userData() && "adminRole" in userData().profile && [
          "proprietor", "proprietress", "manager", "headmaster",
          "headmistress", "administrator", "director", "accountant", "bursar", "admin"
        ].hasAny([userData().profile.adminRole.lower()]))
      );
    }

    function getPermission(screen) {
      return userData() != null
        && ("permissions" in userData())
        && (screen in userData().permissions)
        ? userData().permissions[screen]
        : "deny";
    }

    function hasPermission(screen, level) {
      return (isAdmin() || isStaff() || isTeacher()) &&
        (
          isSuperAdmin() ||
          hasScreenPermission(screen, level)
        );
    }

    function hasScreenPermission(screen, level) {
      let perm = getPermission(screen);
      return (perm == "full") ||
        (perm == "edit" && (level == "edit" || level == "view")) ||
        (perm == "view" && level == "view");
    }

    /* ===============================
       SCREEN PERMISSION HELPERS
       These functions map screens to their required permissions
    =============================== */

    function canManageFees() {
      return hasPermission('manage-fees', 'edit');
    }

    function canViewFees() {
      return hasPermission('manage-fees', 'view');
    }

    function canManageExpenditure() {
      return hasPermission('expenditure', 'edit');
    }

    function canViewExpenditure() {
      return hasPermission('expenditure', 'view');
    }

    function canManagePayroll() {
      return hasPermission('staff-payroll', 'edit');

    }

    function canManageGallery() {
      return hasPermission('gallery', 'edit');
    }

    function canManageNews() {
      return hasPermission('news', 'edit');
    }

    function canManageFAQ() {
      return hasPermission('faq', 'edit');
    }

    function canManageSettings() {
      return hasPermission('settings', 'edit');
    }

    function canManageTimetables() {
      return hasPermission('timetables', 'edit');
    }

    function canManageAcademicCalendar() {
      return hasPermission('academic-calendar', 'edit');
    }

    function canViewAttendance() {
      return isAdmin() || getPermission('attendance') == 'full' || getPermission('attendance') == 'edit' || getPermission('attendance') == 'view';
    }

    function canManageAttendance() {
      return isAdmin() || getPermission('attendance') == 'full' || getPermission('attendance') == 'edit';
    }

    function canViewAcademicRecords() {
      return hasPermission('academic-records', 'view');
    }

    function canManageAcademicRecords() {
      return hasPermission('academic-records', 'edit');
    }

    function canViewScores() {
      return hasPermission('scores', 'view');
    }

    function canManageScores() {
      return hasPermission('scores', 'edit');
    }

    function canViewBehavioralRecords() {
      return hasPermission('behavioral-records', 'view');
    }

    function canManageBehavioralRecords() {
      return hasPermission('behavioral-records', 'edit');
    }

    function canManageAssignments() {
      return hasPermission('assignments', 'edit');
    }

    function canViewAssignments() {
      return hasPermission('assignments', 'view');
    }

    function canManageStudentGroups() {
      return hasPermission('student-groups', 'edit');
    }

    function canViewStudentGroups() {
      return hasPermission('student-groups', 'view');
    }

    function canManageGuestChat() {
      return hasPermission('guest-chat', 'edit');
    }

    function canViewGuestChat() {
      return hasPermission('guest-chat', 'view');
    }

    // Financial permissions (for feeding and bus fee recording)
    function canManageFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit';
    }

    function canViewFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit' || getPermission('feeding') == 'view';
    }

    function canRecordBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit';
    }

    function canViewBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit' || getPermission('record-bus-fee') == 'view';
    }

    function canManageExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit';
    }

    function canViewExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-extra-classes') == 'view' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit' || getPermission('record-class-fee') == 'view';
    }

    function canManageSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit';
    }

    function canViewSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit' || getPermission('manage-sales') == 'view';
    }

 function isTeacher() {
  return userData() != null && (
    userData().role == 'teacher' ||
    userData().get(['profile', 'role'], '') == 'teacher'
  );
}

function isStaff() {
  return userData() != null && (
    userData().role == 'staff' ||
    userData().get(['profile', 'role'], '') == 'staff'
  );
}

function isStudent() {
  return userData() != null && (
    userData().role == 'student' ||
    userData().get(['profile', 'role'], '') == 'student'
  );
}

function isParent() {
  return userData() != null && (
    userData().role == 'parent' ||
    userData().get(['profile', 'role'], '') == 'parent'
  );
}


    function isClassTeacher(classId) {
      let user = userData();
      return isSignedIn() && (isTeacher() || isAdmin() || isStaff()) && (
        user.get('classTeacherOf', '') == classId ||
        user.get('classes', []).hasAny([classId])
      );
    }

    function canCreateNews() {
      return isAdmin() || (isTeacher() && userData() != null && userData().canCreateNews == true);
    }
     function canGenerateCode() {
      return isAdmin() || isTeacher();
    }

    function isEventOrganiser() {
      return isTeacher();
    }
    
     /* ===============================
           SIGNUP CODES
        =============================== */
        match /signupCodes/{codeId} {
          // 1. Allow verification (Step 1 of signup)
          // Restricting to limit == 1 prevents anyone from listing/scraping all valid codes.
          // Both student.tsx and teacher.tsx use a query with a limit of 1.
          allow read: if request.query.limit == 1;

          // 2. Allow Admins/Staff to manage codes
          allow create, delete: if canGenerateCode();

          // 3. Allow newly registered users to "claim" the code in their signup batch
          // Used by teacher.tsx (batch.update)
          allow update: if isSignedIn()
            // Ensure the code hasn't been used yet (handles missing field or false)
            && (!('used' in resource.data) || resource.data.used == false)
            // Ensure they are marking it as used by their own UID
            && request.resource.data.used == true
            && request.resource.data.usedBy == uid();
        }


        /* =========================================================================
       USERS COLLECTION
    ========================================================================= */

    match /users/{userId} {
      // Helper function to check if a teacher has access to a class
      function teacherHasClass(classId) {
        let user = userData();
        return user != null && (
          user.get('classTeacherOf', '') == classId ||
          user.get('classes', []).hasAny([classId])
        );
      }

      // Helper function to check if user is a teacher or staff
      function isEducator() {
        let user = userData();
        return user != null && (
          ['teacher', 'staff'].hasAny([user.role]) ||
          ['teacher', 'staff'].hasAny([user.get(['profile', 'role'], '')])
        );
      }

      // 1. REGISTRATION & LINKING (Public/Unauthenticated)
      // Allows verifying signup codes and parent link codes
      allow read: if (
        (resource.data.status == 'pending_activation' && resource.data.role == 'student') ||
        (resource.data.role == 'student' && 'parentLinkCode' in resource.data)
      ) && (request.query.limit <= 1 || request.query.limit == null);

      // 2. AUTHENTICATED ACCESS
      allow read: if isSignedIn() && (
        uid() == userId
        || (resource.data.get('authUid', '') == uid())
        || isAdmin()
        || isStaff()
        || ['admin', 'teacher'].hasAny([resource.data.role])
        || (isParent() && userData().get('childrenIds', []).hasAny([userId]))
        || (isEducator() && ['student', 'parent'].hasAny([resource.data.role]))
        // 3. TEACHERS/STAFF: Allow querying students in their classes
        // This allows educators to query students where classId matches their assigned classes
        || (isEducator() && resource.data.role == 'student' && teacherHasClass(resource.data.classId))
      );

      // Robust creation rule for new users
      allow create: if isSignedIn() && uid() == userId && (
          ['admin', 'teacher', 'staff', 'student', 'parent', 'guest'].hasAny([request.resource.data.role])
      );

      allow update: if
        isSuperAdmin()
        || hasPermission('manage-users', 'full')
        || (
          // Fee Management: Allow walletBalance updates when reverting payments
          canManageFees()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'walletBalance', 'otherBill', 'otherPaid', 'otherBalance',
            'admissionBalance', 'ptaBalance', 'maintenanceBalance', 'booksBalance', 'uniformBalance',
            'admissionBill', 'ptaBill', 'maintenanceBill', 'booksBill', 'uniformBill',
            'onDiscount', 'discountAmount'
          ])
        )
        || (
          // Feeding/Bus/Extra Classes/Sales: Allow walletBalance updates for teachers with permissions
          // Also allow users delegated full 'manage-users' permission to perform walletBalance updates
          (canManageFeeding() || canRecordBusFee() || canManageExtraClasses() || canManageSales() || getPermission('manage-users') == 'full')
          && (isAdmin() || (isTeacher() && isClassTeacher(resource.data.classId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
        )

        || (
          // Staff Payroll: Allow salary updates if the user has payroll permissions
          canManagePayroll()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salary'])
        )
        || (
          isSignedIn() && (uid() == userId || (resource.data.get('authUid', '') == uid()))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'adminRole', 'uid', 'isAnonymous', 'createdAt', 'permissions'
          ])
        )
        || (
          // UPDATED: Allow Class Teachers to edit their students' records (supports nested/root role)
          (isTeacher() || isAdmin())
          && (resource.data.role == 'student' || resource.data.get(['profile', 'role'], '') == 'student')
          && isClassTeacher(resource.data.classId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'adminRole', 'uid', 'isAnonymous', 'createdAt', 'permissions'
          ])
        )
        || (
          // Allow parents to link themselves to students (Max 2 parents)
          isSignedIn() && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids'])
          && request.resource.data.parentUids.hasAny([uid()])
          && (!('parentUids' in resource.data) || resource.data.parentUids.size() < 2)
        );

      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.status == 'pending_activation');
    }

    /* ===============================
       ADMIN ROLES UNIQUENESS
    =============================== */
    match /adminRoles/{roleName} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.roleName == roleName
        && !exists(/databases/$(database)/documents/adminRoles/$(roleName));
      allow update, delete: if isSuperAdmin();
    }

    /* ===============================
       FINANCE
    =============================== */

    match /studentFeeRecords/{id} {
      allow read: if canViewFees()
        || canViewSales()
        || (isParent() && userData().get('childrenIds', []).hasAny([resource.data.studentUid]))
        || (isStudent() && resource.data.studentUid == uid())
        || (isTeacher() && isClassTeacher(resource.data.classId));
      allow write: if canManageFees() || canManageSales()
        || getPermission('manage-users') == 'full'
        || (isTeacher() && isClassTeacher(request.resource.data.classId) && (
          request.resource.data.adminUid == uid() ||
          getPermission('feeding') in ['full', 'edit'] ||
          getPermission('record-bus-fee') in ['full', 'edit'] ||
          getPermission('record-extra-classes') in ['full', 'edit'] ||
          getPermission('manage-sales') in ['full', 'edit']
        ));
    }

    match /expenditures/{id} {
      allow read: if canViewExpenditure();
      allow create: if canManageExpenditure() &&
        request.resource.data.status == 'open' &&
        request.resource.data.amount > 0;
      allow update: if canManageExpenditure() &&
        (resource.data.status == 'open' || request.resource.data.status == 'closed');
      allow delete: if false;
    }

    /* ===============================
       TEACHER & STUDENT NOTES
    =============================== */
    match /teacher_notes/{noteId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /student_notes/{noteId} {
      allow read, write: if isSignedIn() && (isStudent() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    /* ===============================
       TEACHING & LEARNING MATERIALS (TLM)
    =============================== */
    match /tlms/{tlmId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    /* ===============================
       OTHER COLLECTIONS
    =============================== */

    match /news/{id} {
      allow read: if true;
      allow write: if canManageNews() || canCreateNews();
    }

    match /newscategories/{id} {
      allow read: if true;
      allow write: if canManageNews();
    }
    /* ===============================
       SCHOOL SETTINGS
    =============================== */

    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if canManageSettings() || isAdmin();
    }

    match /timetables/{classId} {
      allow read: if isSignedIn();
      allow write: if canManageTimetables() || isAdmin() || isClassTeacher(classId);
    }

    /* ===============================
       DIRECT MESSAGES COLLECTION & SUBCOLLECTION
    =============================== */
    match /directMessages/{chatId} {
      function isParticipant() {
        return isSignedIn()
          && (chatId.matches('^' + uid() + '_.*|.*_' + uid() + '$'));
      }

      allow read: if isAdmin() || isParticipant();

      match /messages/{messageId} {
        allow read: if isAdmin() || isParticipant();

        allow create: if
          isAdmin()
          || (
            isParticipant()
            && request.resource.data.senderId == uid()
            && request.resource.data.createdAt is timestamp
          );

        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       CLASSES COLLECTION
    =============================== */
    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC CALENDAR
    =============================== */
    match /academic_calendar/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.visibility == 'all' ||
        (userData().role == 'teacher' && resource.data.visibility == 'teachers') ||
        ((userData().role == 'parent' || userData().role == 'student') && resource.data.visibility == 'parents')
      );
      allow create, update, delete: if canManageAcademicCalendar() || isAdmin() || isEventOrganiser();
    }

    /* ===============================
       CHATS COLLECTION (Admin-Parent)
    =============================== */
    match /chats/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    /* ===============================
       PERSONAL TIMETABLES
    =============================== */
    match /personal_timetables/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ===============================
       SUBJECTS COLLECTION
    =============================== */
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       ATTENDANCE COLLECTION
    =============================== */
    match /attendance/{id} {
      function getClassIdFromAttendanceId(attendanceId) {
        return attendanceId.split('_')[0];
      }

      allow read: if
        canViewAttendance() ||
        isAdmin() ||
        (isTeacher() && (isClassTeacher(resource.data.classId) || isClassTeacher(getClassIdFromAttendanceId(id))))
        || (isStudent() && (resource.data.classId == userData().classId || getClassIdFromAttendanceId(id) == userData().classId))
        || (isParent() && ('students' in resource.data) && resource.data.students.keys().hasAny(userData().childrenIds));

      allow write: if canManageAttendance() || isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageAttendance() || isAdmin();
    }

     match /attendanceSummary/{id} {
      allow read: if isSignedIn();
      allow write: if canManageAttendance() || isAdmin() || ((isTeacher() || isStaff()) && isClassTeacher(request.resource.data.classId));
    }


    /* ===============================
       BEHAVIORAL / PRESCHOOL RECORDS
    =============================== */
    match /behavioralRecords/{recordId} {
      // READ: Admins, Teachers of the class, or Parents of students in this record
      allow read: if isSignedIn() && (
        isAdmin() ||
        ((isTeacher() || isStaff()) && (resource == null || isClassTeacher(resource.data.classId))) ||
        (isParent() && resource != null && resource.data.studentIds.hasAny(userData().get('childrenIds', [])))
      );

        // WRITE: Admins or Teachers assigned to the class (or class teacher).
        // Require writes to record the actor and use server timestamp.
        allow create, update: if isSignedIn() && (
          isAdmin() ||
          (
            (isTeacher() || isStaff()) &&
            (
              // teacher is assigned to the class (membership) OR is the class teacher
              (request.resource.data.classId in userData().get('classes', [])) ||
              isClassTeacher(request.resource.data.classId) ||
              // allow updating existing record if the existing record's class lists this user as class teacher
              (resource != null && isClassTeacher(resource.data.classId))
            ) &&
            // ensure the actor is recorded and timestamp is server time
            request.resource.data.updatedBy == uid() &&
            request.resource.data.timestamp == request.time
          )
        );

        // Deletes only allowed by admins or class teachers of the existing record
        allow delete: if isSignedIn() && (
          isAdmin() ||
          ((isTeacher() || isStaff()) && resource != null && isClassTeacher(resource.data.classId))
        );
    }


    /* ===============================
       ASSIGNMENTS COLLECTION
       =============================== */
    match /assignments/{id} {
      // Helper function to check if user owns the assignment (by teacherId)
      function isOwner() {
        return isSignedIn() && resource != null && resource.data.teacherId == uid();
      }

      allow read: if canViewAssignments()
        || isAdmin()
        || isOwner()
        || (isStudent() && resource != null && resource.data.classId == userData().classId)
        || isParent();
      allow create: if isSignedIn() && request.resource.data.teacherId == uid();
      allow update: if canManageAssignments() || (isSignedIn() && resource != null && resource.data.teacherId == uid());
      allow delete: if canManageAssignments() || isAdmin();
    }

    /* ===============================
            SUBMISSIONS COLLECTION
         =============================== */
         match /submissions/{submissionId} {
           allow read: if isSignedIn() && (
             isAdmin() ||
             isTeacher() || isStaff() ||
             (isStudent() && resource != null && resource.data.studentId == uid())
           );

           allow create: if isSignedIn() &&
             isStudent() &&
             request.resource.data.studentId == uid() &&
             // Validate that the timestamp is actually the server time
             request.resource.data.submittedAt == request.time &&
             // Ensure students cannot set grading fields on create
             // Only allow expected submission fields
             request.resource.data.keys().hasOnly([
               'submissionKey', 'assignmentId', 'assignmentTitle', 'assignmentCode', 'studentId', 'studentName',
               'type', 'classId', 'subjectId', 'teacherId', 'responses', 'contentHtml', 'fileUrl', 'fileName',
               'isLate', 'marked', 'submittedAt', 'note', 'noteId', 'status'
             ]) &&
             // Must not mark submissions as already marked
             (request.resource.data.marked == false || !request.resource.data.keys().hasAny(['marked']));

           allow update: if isSignedIn() && (
             isAdmin() ||
             ((isTeacher() || isStaff()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'marked', 'feedback', 'markedAt', 'questionScores']))
           );

           allow delete: if isAdmin();
         }

    /* ===============================
       NOTIFICATIONS COLLECTION
    =============================== */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientId == uid());
      allow create: if isAdmin() || isTeacher();
      allow update: if uid() == resource.data.recipientId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || uid() == resource.data.recipientId;
    }

    /* ===============================
       ACTIVITY LOGS
    =============================== */
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    /* ===============================
       GALLERY & METADATA
    =============================== */
    match /{collection}/{id} {
      allow read: if collection in ['gallery', 'gallery_metadata'];
      allow write: if collection in ['gallery', 'gallery_metadata'] && (canManageGallery() || isAdmin());
    }
match /gallery_metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC YEARS
    =============================== */
    match /academicYears/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       STUDENT GROUPS & MESSAGES
    =============================== */
    match /studentGroups/{groupId} {
      allow read: if canViewStudentGroups() || isAdmin()
        || (isSignedIn() && (
             resource.data.teacherId == uid()
             || (('staffIds' in resource.data) && resource.data.staffIds.hasAny([uid()]))
             || (('studentIds' in resource.data) && resource.data.studentIds.hasAny([uid()]))
           ))
        || (isParent() && ('studentIds' in resource.data) && userData().get('childrenIds', []).hasAny(resource.data.studentIds));
      allow create: if canManageStudentGroups() || (isTeacher() && request.resource.data.teacherId == uid());
      allow update: if canManageStudentGroups() || (isTeacher() && resource.data.teacherId == uid());
      allow delete: if canManageStudentGroups() || isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      match /messages/{messageId} {
        function isGroupMember() {
          return isAdmin() ||
            get(/databases/$(database)/documents/studentGroups/$(groupId)).data.teacherId == uid() ||
            get(/databases/$(database)/documents/studentGroups/$(groupId)).data.get('studentIds', []).hasAny([uid()]);
        }
        
        allow read: if isSignedIn() && isGroupMember();
        allow create: if isSignedIn() && isGroupMember() && request.resource.data.senderId == uid();
      }
    }

    /* ===============================
       GUEST TICKETS & MESSAGES
    =============================== */
    match /guestTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if canViewGuestChat() || isAdmin() || (isSignedIn() && resource.data.guestUid == uid());
      allow update, delete: if canManageGuestChat() || isAdmin();

      match /messages/{messageId} {
        allow read, create: if canViewGuestChat() || isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/guestTickets/$(ticketId)).data.guestUid == uid());
        allow update, delete: if canManageGuestChat() || isAdmin();
      }
    }

    /* ===============================
       FAQS
    =============================== */
    match /faqs/{key} {
      allow read: if true;
      allow write: if canManageFAQ() || isAdmin();
    }

   /* ===============================
       SCORES & REPORTS
    =============================== */
    match /scores/{scoreId} {
      allow read: if canViewScores() || isAdmin() || (isTeacher() && isClassTeacher(resource.data.classId)) || (isStudent() && uid() == resource.data.studentId) || (isParent() && userData().get('childrenIds', []).hasAny([resource.data.studentId]));
      allow write: if canManageScores() || isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageScores() || isAdmin();
    }

    match /student-reports/{reportId} {
      allow read: if canViewScores() || isAdmin() || (isTeacher() && isClassTeacher(resource.data.classId)) || (isStudent() && uid() == resource.data.studentId) || (isParent() && userData().get('childrenIds', []).hasAny([resource.data.studentId]));
      allow write: if canManageScores() || isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageScores() || isAdmin();
    }

   /* ===============================
   ACADEMIC RECORDS (Production Ready)
   =============================== */
   match /academicRecords/{recordId} {
     // Read: Admin, Class Teacher, or the Subject Teacher who created it
     allow read: if isAdmin() ||
                  (isTeacher() && (isClassTeacher(resource.data.classId) || resource.data.teacherId == uid())) ||
                  (isParent() && resource.data.status == 'approved' && userData().get('childrenIds', []).hasAny([resource.data.studentId]));

     allow write: if canManageAcademicRecords() || (isSignedIn() && isTeacher() && (
       // Authorization: Must be Class Teacher OR the teacher assigned to this subject record
       (isClassTeacher(request.resource.data.classId) || request.resource.data.teacherId == uid()) &&

       // Data Integrity: Ensure they aren't changing the student, subject, or class of an existing record
       (resource == null || (
         request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.subject == resource.data.subject &&
         request.resource.data.classId == resource.data.classId
       )) &&

       // Validation: Max Class Score of 50 (if applicable)
       (request.resource.data.get('classScore', 0) is number && request.resource.data.classScore <= 50)
     ));
   }

   match /academicRecordsSummary/{summaryId} {
     // FIX: Added 'teacherId == uid()' so Subject Teachers can see the summaries they created
     allow read: if canViewAcademicRecords() || isAdmin() ||
                  (isTeacher() && (isClassTeacher(resource.data.classId) || resource.data.teacherId == uid())) ||
                  (isStudent() && resource.data.studentId == uid()) ||
                  (isParent() && userData().get('childrenIds', []).hasAny([resource.data.studentId]));

     allow write: if canManageAcademicRecords() || (isSignedIn() && isTeacher() && (
       isClassTeacher(request.resource.data.classId) ||
       request.resource.data.teacherId == uid()
     ));
   }

   // Added protection for Behavioral Records (Preschool Remarks)
   match /behavioralRecords/{recordId} {
     allow read: if isAdmin() || isTeacher() || (isParent() && resource.data.status == 'approved');
     allow write: if isAdmin() || isTeacher(); // Teachers usually manage their own class behavioral data
   }

    /* ===============================
       METADATA
    =============================== */
    match /metadata/schoolStats {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    /* ===============================
       AI & PEDAGOGY COLLECTIONS
    =============================== */
    match /ai_generations/{id} {
      // Teachers can read their own usage and log new generations
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /ai_searches/{id} {
      // Users can log their searches and read their history
      allow read, create: if isSignedIn() && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    match /pedagogy_vault/{id} {
      // Teachers can save and read their own lesson plans
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());

      // Students can read weekly plans for their class
      allow read: if isStudent() && resource.data.classLevel == userData().classId;

      // Allow updates if the teacher is editing their own saved plan
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    /* ===============================
       NON-TEACHING STAFF
       Used for tracking non-teaching staff (drivers, cooks, security, etc.)
       =============================== */
    match /nonTeachingStaff/{staffId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
       }

       /* ===============================
          DAILY FINANCIALS
       =============================== */
       match /dailyFinancials/{id} {
         allow read: if isAdmin() || canViewFeeding() || canViewBusFee() || canViewExtraClasses()
           || (isTeacher() && request.resource.data.classId is string && isClassTeacher(request.resource.data.classId))
           || (isTeacher() && resource != null && isClassTeacher(resource.data.classId))
           || (isParent() && (userData().get('childrenIds', []).hasAny([id.split('_')[0]]) || (resource != null && userData().get('childrenIds', []).hasAny([resource.data.studentUid]))))
           || (isStudent() && (id.split('_')[0] == uid() || (resource != null && resource.data.studentUid == uid())));

         allow create: if isAdmin() || (
             (isTeacher() || isStaff()) && isClassTeacher(request.resource.data.classId) && (
               (request.resource.data.feedingFee is number) ||
               (request.resource.data.busFee is number) ||
               (request.resource.data.extraClassesFee is number)
             )
         );

         allow update: if isAdmin() || (
             (isTeacher() || isStaff()) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'feedingPaid', 'feedingCollector', 'feedingFee',
               'busPaid', 'busCollector', 'busFee',
               'extraPaid', 'extraCollector', 'extraClassesFee',
               'total', 'disbursedAt', 'disbursedBy',
               'updatedAt', 'date', 'studentUid', 'studentName', 'classId', 'className',
               'recordedBy', 'recordedByUid', 'createdAt', 'otherFees', 'otherFeesDescription',
               'feedingPaidAt', 'busPaidAt', 'extraPaidAt'
             ]) && (
               // 1. Feeding Protection: Skip check if keys not touched, otherwise check permission
               (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedingPaid', 'feedingCollector', 'feedingFee']) || canManageFeeding()) &&

               // 2. Bus Protection: Skip check if keys not touched, otherwise check permission or class teacher status
               (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['busPaid', 'busCollector', 'busFee']) || (
                 canRecordBusFee() || (
                   isTeacher() && (isClassTeacher(resource.data.classId)) && (
                     getPermission('record-bus-fee') in ['full', 'edit'] ||
                     getPermission('feeding') in ['full', 'edit'] ||
                     getPermission('record-extra-classes') in ['full', 'edit']
                   )
                 )
               )) &&

               // 3. Extra Classes Protection: Skip check if keys not touched, otherwise check permission or class teacher status
               (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraPaid', 'extraCollector', 'extraClassesFee', 'disbursedAt', 'disbursedBy', 'extraPaidAt']) || canManageExtraClasses() || (
                 isTeacher() && (isClassTeacher(resource.data.classId)) && (
                   getPermission('record-extra-classes') in ['full', 'edit'] ||
                   getPermission('feeding') in ['full', 'edit'] ||
                   getPermission('record-bus-fee') in ['full', 'edit']
                 )
               ))
             )
         );

         allow delete: if isAdmin();
       }

    /* ===============================
       FALLBACK & CATCH-ALL
       =============================== */
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}

