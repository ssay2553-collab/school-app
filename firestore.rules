rules_version = '2';

/* =========================================================
   FIRESTORE RULES - EduEaz
========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid()))
        : null;
    }

    function userData() {
      return userDoc() != null ? userDoc().data : null;
    }

    /* ===============================
       ROLE & PERMISSION CHECKS (Dynamic)
    =============================== */

 function isAdmin() {
  return userData() != null
    && userData().role == "admin";
}

   function isSuperAdmin() {
     return isAdmin() && ((userData().get('adminRole', '').lower() in [
         "proprietor", "proprietress", "manager", "headmaster",
         "headmistress", "administrator", "director", "accountant", "bursar", "admin"
       ]) ||
       (userData().get(['profile', 'adminRole'], '').lower() in [
         "proprietor", "proprietress", "manager", "headmaster",
         "headmistress", "administrator", "director", "accountant", "bursar", "admin"
       ])
     );
   }

    function getPermission(screen) {
      return userData() != null
        && ("permissions" in userData())
        && (screen in userData().permissions)
        ? userData().permissions[screen]
        : "deny";
    }

  function hasPermission(screen, level) {
      return (isAdmin() || isStaff()) &&
        (
      isSuperAdmin() ||
      hasScreenPermission(screen, level)
    );
}

function hasScreenPermission(screen, level) {
  return
    (getPermission(screen) == "full") ||
    (getPermission(screen) == "edit" && (level == "edit" || level == "view")) ||
    (getPermission(screen) == "view" && level == "view");
}
/* ===============================
       SCREEN PERMISSION HELPERS
       These functions map screens to their required permissions
    =============================== */

    function canManageFees() {
      return hasPermission('manage-fees', 'edit');
    }

    function canViewFees() {
      return hasPermission('manage-fees', 'view');
    }

    function canManageExpenditure() {
      return hasPermission('expenditure', 'edit');
    }

    function canViewExpenditure() {
      return hasPermission('expenditure', 'view');
    }

    function canManagePayroll() {
      return hasPermission('staff-payroll', 'edit');

    }

    function canManageFAQ() {
      return hasPermission('faq', 'edit');
    }


    function canManageTimetables() {
      return hasPermission('timetables', 'edit');
    }

    function canManageAcademicCalendar() {
      return hasPermission('academic-calendar', 'edit');
    }

    function canViewAttendance() {
      return hasPermission('attendance', 'view');
    }

    function canManageAttendance() {
      return isAdmin() || getPermission('attendance') == 'full' || getPermission('attendance') == 'edit';
    }

    function canManageAssignments() {
      return hasPermission('assignments', 'edit');
    }

    function canViewAssignments() {
      return hasPermission('assignments', 'view');
    }


    // Financial permissions (for feeding and bus fee recording)
    function canManageFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit';
    }

    function canViewFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit' || getPermission('feeding') == 'view';
    }

    function canRecordBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit';
    }

    function canViewBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit' || getPermission('record-bus-fee') == 'view';
    }

    function canManageExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit';
    }

    function canViewExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-extra-classes') == 'view' || getPermission('record-class-fee') == 'full' || getPermission('record-class-fee') == 'edit' || getPermission('record-class-fee') == 'view';
    }

    function canManageSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit';
    }

    function canViewSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit' || getPermission('manage-sales') == 'view';
    }


    function isTeacher() {
  return request.auth != null
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
}

    // Helper: Check if teacher is the official class teacher for a specific class
    function isClassTeacher(classId) {
      return (get(/databases/$(database)/documents/classes/$(classId)).data.classTeacherId == request.auth.uid) ||
             (classId in userData().get('classes', [])) ||
             (userData().get('classTeacherOf', '') == classId);
    }

    function isStaff() {
      return userData() != null && (
        userData().get('role', '') == 'staff' ||
        userData().get(['profile', 'role'], '') == 'staff'
      );
    }

    function isStudent() {
      return userData() != null && (
        userData().get('role', '') == 'student' ||
        userData().get(['profile', 'role'], '') == 'student'
      );
    }

    function isParent() {
      return userData() != null && userData().role == 'parent';
    }

    function isParentOf(studentId) {
      return isSignedIn() && (
        studentId in userData().get('childrenIds', []) ||
        studentId in userData().get(['profile', 'childrenIds'], [])
      );
    }


    function canCreateNews() {
      return isAdmin() || (isTeacher() && userData() != null && userData().canCreateNews == true);
    }
     function canGenerateCode() {
      return isAdmin() || isTeacher();
    }

    function isEventOrganiser() {
      return isTeacher();
    }

    /* =========================================================================
       USERS COLLECTION
    ========================================================================= */
      match /users/{userId} {

  allow read: if
        isAdmin()
        || (isSignedIn() && uid() == userId)
        || (isTeacher() && resource.data.role == 'student')
        || (isParent() && resource.data.role in ['teacher', 'admin'])
        || (isParent() && userData() != null && (
             (userId in userData().childrenIds) ||
             (uid() in resource.data.get('parentUids', []))
           ))
        || (isTeacher() && resource.data.role == 'parent')
        // UPGRADED: Discovery rule for Signup / Student Claiming
        // Allows users to find a student profile ONLY if they use a limit of 1
        // and search specifically for a student with a parentLinkCode or signupCode.
        || (resource.data.role == 'student'
            && (
              ('parentLinkCode' in resource.data) ||
              (resource.data.status == 'pending_activation' && 'signupCode' in resource.data)
            )
            && request.query.limit <= 1
           );

  /* ==============================
     CREATE
  =============================== */
allow create: if
    isSignedIn() &&
    (uid() == userId || isSuperAdmin() || hasPermission('manage-users', 'full')) &&
    (

      // ==========================================================
      // TEACHER / STUDENT
      // ==========================================================
      (
        request.resource.data.role in ['teacher', 'student'] &&
        !('permissions' in request.resource.data) &&
        !('adminRole' in request.resource.data) &&
        !('assignedRoles' in request.resource.data) &&
        !('permissions' in request.resource.data.get('profile', {})) &&
        !('adminRole' in request.resource.data.get('profile', {})) &&
        !('assignedRoles' in request.resource.data.get('profile', {})) &&

        // Security: Prevent students from setting their own balance during signup
        (request.resource.data.role == 'student' ? (
          (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0)
        ) : true)
      )

      ||

      // ==========================================================
      // PARENT
      // ==========================================================
      (
        request.resource.data.role == 'parent' &&

        // Prevent privilege escalation
        !('permissions' in request.resource.data) &&
        !('adminRole' in request.resource.data) &&
        !('assignedRoles' in request.resource.data) &&
        !('permissions' in request.resource.data.get('profile', {})) &&
        !('adminRole' in request.resource.data.get('profile', {})) &&
        !('assignedRoles' in request.resource.data.get('profile', {})) &&

        // Validate parent document
        request.resource.data.childrenIds is list &&
        request.resource.data.childrenClassIds is list &&
        request.resource.data.status is string &&
        request.resource.data.createdAt is timestamp &&

        request.resource.data.profile is map &&
        request.resource.data.profile.keys().hasAll([
          'firstName',
          'lastName',
          'email'
        ]) &&
        request.resource.data.profile.firstName is string &&
        request.resource.data.profile.lastName is string &&
        request.resource.data.profile.email is string &&

        request.resource.data.keys().hasOnly([
          'uid',
          'role',
          'profile',
          'childrenIds',
          'childrenClassIds',
          'status',
          'createdAt'
        ])
      )

      ||

      // ==========================================================
      // GUEST
      // ==========================================================
      (
        request.resource.data.role == 'guest' &&

        // Prevent privilege escalation
        !('permissions' in request.resource.data) &&
        !('adminRole' in request.resource.data) &&
        !('assignedRoles' in request.resource.data) &&
        !('permissions' in request.resource.data.get('profile', {})) &&
        !('adminRole' in request.resource.data.get('profile', {})) &&
        !('assignedRoles' in request.resource.data.get('profile', {})) &&

        // Validate guest document
        request.resource.data.uid == userId &&
        request.resource.data.isAnonymous == true &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt is timestamp &&

        request.resource.data.profile is map &&
        request.resource.data.profile.keys().hasOnly([
          'fullName',
          'phone'
        ]) &&
        request.resource.data.profile.fullName is string &&
        request.resource.data.profile.phone is string &&

        request.resource.data.keys().hasOnly([
          'uid',
          'role',
          'isAnonymous',
          'profile',
          'status',
          'createdAt'
        ])
      )

      ||

      // ==========================================================
      // INITIAL ADMIN SIGNUP
      // ==========================================================
      (
        request.resource.data.role == 'admin' &&
        (
          (
            'adminRole' in request.resource.data &&
            existsAfter(
              /databases/$(database)/documents/adminRoles/$(request.resource.data.adminRole.lower())
            )
          )
          ||
          (
            'adminRole' in request.resource.data.get('profile', {}) &&
            existsAfter(
              /databases/$(database)/documents/adminRoles/$(request.resource.data.profile.adminRole.lower())
            )
          )
        )
      )
    );
  /* ===============================
     UPDATE
  =============================== */

  allow update: if
      isSuperAdmin() ||
      hasPermission('manage-users', 'full')

      // Student claiming a pre-registered account (Fallback for Cloud Function)
      || (
        isSignedIn()
        && resource.data.role == 'student'
        && resource.data.status == 'pending_activation'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'claimedAt'])
      )

      // User updating own profile
      || (
        isSignedIn() &&
        uid() == userId &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'adminRole',
            'uid',
            'isAnonymous',
            'createdAt',
            'permissions',
            'walletBalance',
            'financeLastReconciled',
            'otherBill',
            'otherPaid',
            'otherBalance',
            'admissionBalance',
            'ptaBalance',
            'maintenanceBalance',
            'booksBalance',
            'uniformBalance',
            'admissionBill',
            'ptaBill',
            'maintenanceBill',
            'booksBill',
            'uniformBill',
            'ptaPaid',
            'maintenancePaid',
            'booksPaid',
            'uniformPaid',
            'admissionPaid',
            'salary'
          ])
      )



      // Parent linking to student (maximum 2)
      || (
       isSignedIn()
          && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids'])
          && request.resource.data.parentUids is list
          && uid() in request.resource.data.parentUids
          && (resource.data.parentUids is list ? resource.data.parentUids.size() < 2 : true)
          && request.resource.data.parentUids.hasAll(resource.data.parentUids)
          && request.resource.data.parentUids.size() <= 2
        )


      // Fee Management
      || (
        canManageFees() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'walletBalance',
            'financeLastReconciled',
            'otherBill',
            'otherPaid',
            'otherBalance',
            'admissionBalance',
            'ptaBalance',
            'maintenanceBalance',
            'booksBalance',
            'uniformBalance',
            'admissionBill',
            'ptaBill',
            'maintenanceBill',
            'booksBill',
            'uniformBill',
            'onDiscount',
            'discountAmount',
            'ptaPaid',
            'maintenancePaid',
            'booksPaid',
            'uniformPaid',
            'admissionPaid'
          ])
      )

      // Wallet updates by delegated staff
      || (
        (
          canManageFeeding() ||
          canRecordBusFee() ||
          canManageExtraClasses() ||
          canManageSales() ||
          getPermission('manage-users') == 'full'
        ) &&
        (
          isAdmin() ||
          ((isTeacher() || isStaff()) &&
            isClassTeacher(resource.data.classId))
        ) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['walletBalance'])
      )

      // Payroll
      || (
        canManagePayroll() &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['salary'])
      )

      // Staff/Class Teacher editing student records
      || (
        (
          hasPermission('manage-users', 'edit') ||
          (
            (isTeacher() || isAdmin() || isStaff()) &&
            isClassTeacher(resource.data.classId)
          )
        ) &&
        (
          resource.data.role == 'student' ||
          resource.data.get(['profile', 'role'], '') == 'student'
        ) &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'adminRole',
            'uid',
            'isAnonymous',
            'createdAt',
            'permissions',
            'walletBalance',
            'salary',
            'parentUids',
            'parentLinkCode'
          ])
      );

  /* ===============================
     DELETE
  =============================== */

  allow delete: if isSuperAdmin();
}
    /* ===============================
       ADMIN ROLES UNIQUENESS
    =============================== */
   match /adminRoles/{roleName} {
     allow read: if true;

     allow create: if isSignedIn()
       && request.resource.data.uid == uid()
       && request.resource.data.roleName == roleName
       // Ensure they are also creating their user doc in the same batch
       && existsAfter(/databases/$(database)/documents/users/$(uid()));

     allow update, delete: if isSuperAdmin();
   }



/* =========================================================================
   FEE RECORDS & PAYMENTS
========================================================================= */

match /studentFeeRecords/{recordId} {
  // Allow read if Admin, or if the parent is linked to the student
  allow read: if isSignedIn() && (
    isAdmin() ||
    (isParent() && recordId.split('_')[0] in userData().childrenIds)
  );

  // Only Admins or those with fee management permissions can write
  // Enforce valid academic metadata to prevent orphaned records
  allow write: if canManageFees() &&
    request.resource.data.academicYear is string && request.resource.data.academicYear != "" &&
    request.resource.data.term is string && request.resource.data.term != "" &&
    request.resource.data.studentUid is string && request.resource.data.studentUid != "";
}

match /feePayments/{paymentId} {
  // Allow read if Admin, or if the payment belongs to one of the parent's children
  allow read: if isSignedIn() && (
    isAdmin() ||
    (isParent() && resource.data.studentUid in userData().childrenIds)
  );

  // Enforce valid academic metadata for all financial transactions
  allow create: if canManageFees() &&
    request.resource.data.academicYear is string && request.resource.data.academicYear != "" &&
    request.resource.data.term is string && request.resource.data.term != "" &&
    request.resource.data.studentUid is string && request.resource.data.studentUid != "";

  allow update, delete: if isAdmin();
}

    match /expenditures/{id} {
      allow read: if canViewExpenditure();
      allow create: if canManageExpenditure() &&
        request.resource.data.status == 'open' &&
        request.resource.data.amount > 0;
      allow update: if canManageExpenditure() &&
        (resource.data.status == 'open' || request.resource.data.status == 'closed');
      allow delete: if false;
    }

   match /payroll/{id} {
      allow read, create, update, delete: if hasPermission('staff-payroll', 'edit') || (hasPermission('staff-payroll', 'view') && request.method == 'get');
    }
     /* ===============================
       TEACHER & STUDENT NOTES
    =============================== */
    match /teacher_notes/{noteId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /student_notes/{noteId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        uid() == resource.data.uid ||
        (isTeacher() && isClassTeacher(get(/databases/$(database)/documents/users/$(resource.data.uid)).data.classId))
      );
      allow create: if isSignedIn() && (
        isStudent() && request.resource.data.uid == uid()
      );
      allow update: if isSignedIn() && uid() == resource.data.uid;
      allow delete: if isSignedIn() && (isAdmin() || uid() == resource.data.uid);
    }

    /* ===============================
       TEACHING & LEARNING MATERIALS (TLM)
    =============================== */
    match /tlms/{tlmId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    /* ===============================
       OTHER COLLECTIONS
    =============================== */

    match /signupCodes/{codeId} {
      // Restrict read to single-code verification to prevent bulk scraping
      allow get: if true;
      allow list: if isAdmin() || (request.query.limit <= 1);
      allow create: if canGenerateCode() && (
        isAdmin() || (isTeacher() && request.resource.data.intendedForRole == 'student')
      );
      allow delete: if isAdmin();
      allow update: if (isSignedIn()
        && (!('used' in resource.data) || resource.data.used == false)
        && request.resource.data.used == true
        && request.resource.data.usedBy == uid())
        || (
          isSignedIn() && isAdmin()
        );
    }
    match /news/{id} {
      allow read: if true;
      allow write: if canCreateNews();
    }

/* ===============================
       SCHOOL SETTINGS
    =============================== */
    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

     match /timetables/{classId} {
      allow read: if isSignedIn();
      allow write: if canManageTimetables() || isAdmin() || isClassTeacher(classId);
    }


    /* ===============================
       DIRECT MESSAGES COLLECTION & SUBCOLLECTION
    =============================== */
    match /directMessages/{chatId} {
      function isParticipant() {
        return isSignedIn()
          && (chatId.matches('^' + uid() + '_.*|.*_' + uid() + '$'));
      }

      allow read: if isAdmin() || isParticipant();

      match /messages/{messageId} {
        allow read: if isAdmin() || isParticipant();

        allow create: if
          isAdmin()
          || (
            isParticipant()
            && request.resource.data.senderId == uid()
            && request.resource.data.createdAt is timestamp
          );

        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       CLASSES COLLECTION
    =============================== */
    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC CALENDAR
    =============================== */
    match /academic_calendar/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.visibility == 'all' ||
        (userData().role == 'teacher' && resource.data.visibility == 'teachers') ||
        ((userData().role == 'parent' || userData().role == 'student') && resource.data.visibility == 'parents')
      );
      allow create, update, delete: if canManageAcademicCalendar() || isAdmin() || isEventOrganiser();
    }

    /* ===============================
       CHATS COLLECTION (Admin-Parent)
    =============================== */
    match /chats/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    /* ===============================
       PERSONAL TIMETABLES
    =============================== */
    match /personal_timetables/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ===============================
       SUBJECTS COLLECTION
    =============================== */
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       ATTENDANCE COLLECTION
    =============================== */
    match /attendance/{id} {
      function getClassIdFromAttendanceId(attendanceId) {
        return attendanceId.split('_')[0];
      }

      allow read: if
      canViewAttendance() ||
        isAdmin()
        || (isTeacher() && ((resource.data.classId in userData().classes) || (getClassIdFromAttendanceId(id) in userData().classes)))
        || (isStudent() && resource.data.classId == userData().classId)
        || (isParent() && exists(/databases/$(database)/documents/users/$(uid())) && (resource.data.students.keys().hasAny(userData().childrenIds)));

      allow write: if canManageAttendance() || isAdmin() || (isTeacher() && (isClassTeacher(request.resource.data.classId) || (request.resource.data.classId in userData().get('classes', []))));
      allow delete: if canManageAttendance() || isAdmin();
    }

    match /attendanceSummary/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && (resource == null || (resource.data.classId in userData().get('classes', [])))) ||
        (isStudent() && (id.split('_')[0] == uid() || (resource != null && resource.data.studentId == uid()))) ||
        (isParent() && (id.split('_')[0] in userData().get('childrenIds', []) || (resource != null && resource.data.studentId in userData().get('childrenIds', []))))
      );
      allow write: if isAdmin() ||
        (isSignedIn() && (isTeacher() || isStaff()) &&
        (
          // Allow if they are the teacher for the class being updated
          isClassTeacher(request.resource.data.classId) ||
          (request.resource.data.classId in userData().get('classes', [])) ||
          // Or if the resource already exists and they are the teacher
          (resource != null && (
            isClassTeacher(resource.data.classId) ||
            (resource.data.classId in userData().get('classes', []))
          ))
        ));
    }

    /* ===============================
       ASSIGNMENTS COLLECTION
    =============================== */
   match /assignments/{id} {
      allow read: if canViewAssignments() || isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || (isStudent() && resource.data.classId == userData().classId) || isParent();
      allow create, update: if canManageAssignments() || (isTeacher() && request.resource.data.teacherId == uid());
      allow delete: if canManageAssignments() || isAdmin();
    }

     /* ===============================
            SUBMISSIONS COLLECTION
         =============================== */
         match /submissions/{submissionId} {
           allow read: if isSignedIn() && (
             isAdmin() ||
             isTeacher() ||
             (isStudent() && resource.data.studentId == uid())
           );

           allow create: if isSignedIn() &&
             isStudent() &&
             request.resource.data.studentId == uid() &&
             // Validate that the timestamp is actually the server time
             request.resource.data.submittedAt == request.time;

           allow update: if isSignedIn() && (
             isAdmin() ||
             (isTeacher() && (
               resource.data.assignmentId in (get(/databases/$(database)/documents/users/$(uid())).data.assignedAssignments) ||
               // Fallback: check if they are the teacher of the student
               isClassTeacher(get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.classId)
             ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'marked', 'feedback', 'markedAt', 'questionScores']))
           );

           allow delete: if isAdmin();
         }

     /* ===============================
       NOTIFICATIONS COLLECTION
    =============================== */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientId == uid());
      allow create: if isAdmin() || isTeacher();
      allow update: if uid() == resource.data.recipientId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || uid() == resource.data.recipientId;
    }

    /* ===============================
       ACTIVITY LOGS
    =============================== */
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    /* ===============================
       GALLERY & METADATA
    =============================== */
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery_metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC YEARS
    =============================== */
    match /academicYears/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       NEWS CATEGORIES
    =============================== */
    match /newscategories/{id} {
      allow read: if true;
    }

    /* ===============================
       STUDENT GROUPS & MESSAGES
    =============================== */
    match /studentGroups/{groupId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || (isStudent() && uid() in resource.data.studentIds) || (isParent() && userData().childrenIds.hasAny(resource.data.studentIds));
      allow create: if isTeacher() && request.resource.data.teacherId == uid();
      allow update: if isTeacher() && resource.data.teacherId == uid();
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      match /messages/{messageId} {
        function isGroupMember() {
          let group = get(/databases/$(database)/documents/studentGroups/$(groupId)).data;
          return isAdmin() || group.teacherId == uid() || uid() in group.studentIds;
        }
        allow read: if isSignedIn() && isGroupMember();
        allow create: if isSignedIn() && isGroupMember() && request.resource.data.senderId == uid();
      }
    }

    /* ===============================
       GUEST TICKETS & MESSAGES
    =============================== */
    match /guestTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.guestUid == uid());
      allow update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/guestTickets/$(ticketId)).data.guestUid == uid());
        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       FAQS
    =============================== */
    match /faqs/{key} {
      allow read: if true;
      allow write: if canManageFAQ() || isAdmin();
    }

    /* ===============================
       SCORES COLLECTION
    =============================== */
    match /scores/{scoreId} {
      allow read: if
        isAdmin()
        || (isTeacher() && resource.data.classId in userData().classes)
        || (isStudent() && uid() == resource.data.studentId)
        || (isParent() && resource.data.studentId in userData().childrenIds);

      allow write: if
        isAdmin()
        || (isTeacher() && request.resource.data.classId in userData().classes);

      allow delete: if isAdmin();
    }

/* ===============================
   ACADEMIC RECORDS
=============================== */
   match /academicRecords/{recordId} {
      allow read: if isSignedIn();

      // Admins have full access; Teachers can only create/edit if not already approved
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && isClassTeacher(request.resource.data.classId) && request.resource.data.status == 'pending')
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isTeacher() &&
          isClassTeacher(resource.data.classId) &&
          resource.data.status != 'approved' &&
          request.resource.data.status == 'pending' &&
          (
            !request.resource.data.get('containsBehavioralData', false) ||
            isClassTeacher(resource.data.classId)
          )
        )
      );

      allow delete: if isAdmin();
   }

 match /student-reports/{reportId} {
      allow read: if
        isAdmin()
        || (isTeacher() && resource.data.classId in userData().classes)
        || (isStudent() && uid() == resource.data.studentId && resource.data.status == 'approved')
        || (isParent() && resource.data.studentId in userData().childrenIds && resource.data.status == 'approved');

      allow write: if
        isAdmin()
        || (isTeacher() && request.resource.data.classId in userData().classes);

      allow delete: if isAdmin();

}

match /academicRecordsSummary/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && resource.data.classId in userData().classes) ||
        (isStudent() && id.split('_')[0] == uid()) ||
        (isParent() && id.split('_')[0] in userData().childrenIds)
      );
      allow write: if isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
    }

    /* ===============================
       BEHAVIORAL / PRESCHOOL RECORDS
    =============================== */
        match /behavioralRecords/{recordId} {

          // READ:
          // 1. Admins
          // 2. Teachers can read if the class is in their assigned 'classes' array
          // 3. Parents can read if the record is for their child's class (security via classId)
          allow read: if isSignedIn() && (
            isAdmin() ||
            (isTeacher() && resource.data.classId in userData().classes) ||
            (isParent() && resource.data.classId in userData().get('childrenClassIds', [])) ||
            (isParent() && resource.data.studentIds.hasAny(userData().get('childrenIds', [])))
          );

          // WRITE:
          // 1. Admins
          // 2. Teachers can write if the class they are saving to is in their 'classes' array
          allow write: if isSignedIn() && (
            isAdmin() ||
            (isTeacher() && request.resource.data.classId in userData().classes)
          );
        }

     /* ===============================
       WEEKLY TOPICS
    =============================== */
    match /weeklyTopics/{topicId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isAdmin() ||
        (isTeacher() && request.resource.data.classId in userData().classes)
      );
      allow delete: if isAdmin();
    }

    /* ===============================
       GAME ACHIEVEMENTS
    =============================== */
    match /gameAchievements/{studentId} {
      // Allow any signed-in user to read for the global leaderboard
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == studentId;
    }

    match /pedagogy_vault/{id} {
      // Teachers can save and read their own lesson plans
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());

      // Students can read weekly plans for their class
      allow read: if isStudent() && resource.data.classLevel == userData().classId;

      // Allow updates if the teacher is editing their own saved plan
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    /* ===============================
       METADATA
    =============================== */
    match /metadata/schoolStats {
      allow read, write: if false;
    }

    /* ===============================
       NON-TEACHING STAFF
       Used for tracking non-teaching staff (drivers, cooks, security, etc.)
       =============================== */
    match /nonTeachingStaff/{staffId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
       }

    /* ===============================
       DAILY FINANCIALS
    =============================== */
    match /dailyFinancials/{id} {
      allow read: if canViewFeeding() || canViewBusFee() || canViewExtraClasses() || isAdmin()
        || (isParent() && (id.split('_')[0] in userData().get('childrenIds', []) || (resource != null && resource.data.studentUid in userData().get('childrenIds', []))))
        || (isStudent() && (id.split('_')[0] == uid() || (resource != null && resource.data.studentUid == uid())));

      allow create: if isAdmin() || (
          (isTeacher() || isStaff()) &&
          isClassTeacher(request.resource.data.classId) && (
            (request.resource.data.feedingFee is number) ||
            (request.resource.data.busFee is number) ||
            (request.resource.data.extraClassesFee is number)
          )
      );

      allow update: if isAdmin() || (
          (isTeacher() || isStaff()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'feedingPaid', 'feedingCollector', 'feedingFee', 'feedingPaidAmount',
            'busPaid', 'busCollector', 'busFee', 'busPaidAmount',
            'extraPaid', 'extraCollector', 'extraClassesFee', 'extraPaidAmount',
            'total', 'disbursedAt', 'disbursedBy',
            'updatedAt', 'date', 'studentUid', 'studentName', 'classId', 'className',
            'recordedBy', 'recordedByUid', 'createdAt', 'otherFees', 'otherFeesDescription',
            'feedingPaidAt', 'busPaidAt', 'extraPaidAt', 'academicYear', 'term'
          ]) && (
            // Feeding fields: Allow if has feeding permission OR is class teacher with any financial permission
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedingPaid', 'feedingCollector', 'feedingFee', 'feedingPaidAmount']) || (
              canManageFeeding() || (
                isTeacher() && (
                  (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
                  (resource != null && isClassTeacher(resource.data.classId))
                ) && (
                  getPermission('feeding') in ['full', 'edit'] ||
                  getPermission('record-bus-fee') in ['full', 'edit'] ||
                  getPermission('record-extra-classes') in ['full', 'edit']
                )
              )
            )) &&

            // Bus fields require either the dedicated bus permission OR be a class-teacher with an appropriate payment permission
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['busPaid', 'busCollector', 'busFee', 'busPaidAmount']) || (
              canRecordBusFee() || (
                isTeacher() && (
                  (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
                  (resource != null && isClassTeacher(resource.data.classId))
                ) && (
                  getPermission('record-bus-fee') in ['full', 'edit'] ||
                  getPermission('feeding') in ['full', 'edit'] ||
                  getPermission('record-extra-classes') in ['full', 'edit']
                )
              )
            )) &&

            // Extra-classes fields: similar logic to allow class-teacher with related permissions
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraPaid', 'extraCollector', 'extraClassesFee', 'disbursedAt', 'disbursedBy', 'extraPaidAt', 'extraPaidAmount']) || canManageExtraClasses() || (
              isTeacher() && (
                (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
                (resource != null && isClassTeacher(resource.data.classId))
              ) && (
                getPermission('record-extra-classes') in ['full', 'edit'] ||
                getPermission('feeding') in ['full', 'edit'] ||
                getPermission('record-bus-fee') in ['full', 'edit']
              )
            ))
          )
      );

      allow delete: if isAdmin();
    }
    /* ===============================
       FALLBACK & CATCH-ALL
    =============================== */
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
