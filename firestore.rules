rules_version = '2';

/* =========================================================
   FIRESTORE RULES - EduEaz

   This file defines security rules for Firestore database.
   It includes permission checks for all screens in the app.

   SCREENS COVERED BY PERMISSION SYSTEM:
   =====================================

   Admin Screens:
   - manage-users: User management
   - manage-fees: Student fee management
   - expenditure: School expenditure tracking
   - staff-payroll: Staff salary management
   - gallery: Media library management
   - news: School announcements
   - faq: FAQ management
   - settings: School settings
   - timetables: Class timetables
   - academic-calendar: School events
   - generate-codes: Signup code generation

   Academic Screens:
   - attendance: Daily attendance tracking
   - academic-records: Student academic records
   - scores: Student scores and grades
   - behavioral-records: Student conduct logs
   - assignments: Homework and assignments
   - student-groups: Study groups

   Communication Screens:
   - staff-chat: Internal staff messaging
   - parent-chat: Admin-parent communication
   - guest-chat: Guest inquiries

   Financial Screens (for non-admin users):
   - feeding: Meal fee recording
   - record-bus-fee: Bus fee recording

========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid()))
        : null;
    }

    function userData() {
      return userDoc() != null ? userDoc().data : null;
    }

    /* ===============================
       ROLE & PERMISSION CHECKS (Dynamic)
    =============================== */

    function isAdmin() {
      return userData() != null && (
        userData().role == "admin" ||
        (userData().get(['profile', 'role'], '') == 'admin')
      );
    }

    function isSuperAdmin() {
      return isAdmin() && (
        ("adminRole" in userData() && userData().adminRole.toLower() in [
          "proprietor", "proprietress", "manager", "headmaster",
          "headmistress", "administrator", "director", "accountant", "bursar", "admin"
        ]) ||
        ("profile" in userData() && "adminRole" in userData().profile && userData().profile.adminRole.toLower() in [
          "proprietor", "proprietress", "manager", "headmaster",
          "headmistress", "administrator", "director", "accountant", "bursar", "admin"
        ])
      );
    }

    function getPermission(screen) {
      return userData() != null
        && ("permissions" in userData())
        && (screen in userData().permissions)
        ? userData().permissions[screen]
        : "deny";
    }

    function hasPermission(screen, level) {
      return (isAdmin() || isStaff()) &&
        (
          isSuperAdmin() ||
          hasScreenPermission(screen, level)
        );
    }

    function hasScreenPermission(screen, level) {
      let perm = getPermission(screen);
      return (perm == "full") ||
        (perm == "edit" && (level == "edit" || level == "view")) ||
        (perm == "view" && level == "view");
    }

    /* ===============================
       SCREEN PERMISSION HELPERS
       These functions map screens to their required permissions
    =============================== */

    // Admin-only screens
    function canManageUsers() {
      return hasPermission('manage-users', 'edit');
    }

    function canManageFees() {
      return hasPermission('manage-fees', 'edit');
    }

    function canViewFees() {
      return hasPermission('manage-fees', 'view');
    }

    function canManageExpenditure() {
      return hasPermission('expenditure', 'edit');
    }

    function canViewExpenditure() {
      return hasPermission('expenditure', 'view');
    }

    function canManagePayroll() {
      return hasPermission('staff-payroll', 'edit');
    }

    function canViewPayroll() {
      return hasPermission('staff-payroll', 'view');
    }

    function canManageGallery() {
      return hasPermission('gallery', 'edit');
    }

    function canManageNews() {
      return hasPermission('news', 'edit');
    }

    function canManageFAQ() {
      return hasPermission('faq', 'edit');
    }

    function canManageSettings() {
      return hasPermission('settings', 'edit');
    }

    function canManageTimetables() {
      return hasPermission('timetables', 'edit');
    }

    function canManageAcademicCalendar() {
      return hasPermission('academic-calendar', 'edit');
    }

    function canGenerateCodes() {
      return isAdmin();
    }

    function canViewAttendance() {
      return hasPermission('attendance', 'view');
    }

    function canManageAttendance() {
      return hasPermission('attendance', 'edit');
    }

    function canViewAcademicRecords() {
      return hasPermission('academic-records', 'view');
    }

    function canManageAcademicRecords() {
      return hasPermission('academic-records', 'edit');
    }

    function canViewScores() {
      return hasPermission('scores', 'view');
    }

    function canManageScores() {
      return hasPermission('scores', 'edit');
    }

    function canViewBehavioralRecords() {
      return hasPermission('behavioral-records', 'view');
    }

    function canManageBehavioralRecords() {
      return hasPermission('behavioral-records', 'edit');
    }

    function canManageAssignments() {
      return hasPermission('assignments', 'edit');
    }

    function canViewAssignments() {
      return hasPermission('assignments', 'view');
    }

    function canManageStudentGroups() {
      return hasPermission('student-groups', 'edit');
    }

    function canViewStudentGroups() {
      return hasPermission('student-groups', 'view');
    }

    function canManageStaffChat() {
      return hasPermission('staff-chat', 'edit');
    }

    function canViewStaffChat() {
      return hasPermission('staff-chat', 'view');
    }

    function canManageParentChat() {
      return hasPermission('parent-chat', 'edit');
    }

    function canViewParentChat() {
      return hasPermission('parent-chat', 'view');
    }

    function canManageGuestChat() {
      return hasPermission('guest-chat', 'edit');
    }

    function canViewGuestChat() {
      return hasPermission('guest-chat', 'view');
    }

    // Financial permissions (for feeding and bus fee recording)
    function canManageFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit';
    }

    function canViewFeeding() {
      return isAdmin() || getPermission('feeding') == 'full' || getPermission('feeding') == 'edit' || getPermission('feeding') == 'view';
    }

    function canRecordBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit';
    }

    function canViewBusFee() {
      return isAdmin() || getPermission('record-bus-fee') == 'full' || getPermission('record-bus-fee') == 'edit' || getPermission('record-bus-fee') == 'view';
    }

    function canManageExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit';
    }

    function canViewExtraClasses() {
      return isAdmin() || getPermission('record-extra-classes') == 'full' || getPermission('record-extra-classes') == 'edit' || getPermission('record-extra-classes') == 'view';
    }

    function canManageSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit';
    }

    function canViewSales() {
      return isAdmin() || getPermission('manage-sales') == 'full' || getPermission('manage-sales') == 'edit' || getPermission('manage-sales') == 'view';
    }

    // Financial access is restricted to super admins or admins with manage-users permission
    // This matches the client-side logic in DailyFinancials.tsx
    function hasFinancialAccess() {
      return isSuperAdmin() || getPermission('manage-users') == 'full';
    }


    function isTeacher() {
      return userData() != null && userData().role == 'teacher';
    }

    function isStaff() {
      return userData() != null && userData().role == 'staff';
    }

    function isStudent() {
      return userData() != null && userData().role == 'student';
    }

    function isParent() {
      return userData() != null && userData().role == 'parent';
    }

    function isClassTeacher(classId) {
      return isSignedIn() && (isTeacher() || isAdmin()) && (
        userData().classTeacherOf == classId ||
        (('classes' in userData()) && classId in userData().classes) ||
        (exists(/databases/$(database)/documents/classes/$(classId)) && get(/databases/$(database)/documents/classes/$(classId)).data.classTeacherId == uid())
      );
    }

    function canCreateNews() {
      return isAdmin() || (isTeacher() && userData() != null && userData().canCreateNews == true);
    }
     function canGenerateCode() {
      return isAdmin() || isTeacher();
    }

    function isEventOrganiser() {
      return isTeacher();
    }

    /* =========================================================================
       USERS COLLECTION
    ========================================================================= */

    match /users/{userId} {
      // 1. REGISTRATION & LINKING (Public/Unauthenticated)
      // Allows verifying signup codes and parent link codes
      allow read: if (
        (resource.data.status == 'pending_activation' && resource.data.role == 'student') ||
        (resource.data.role == 'student' && 'parentLinkCode' in resource.data)
      ) && (request.query.limit <= 1 || request.query.limit == null);

      // 2. AUTHENTICATED ACCESS
      allow read: if isSignedIn() && (
        uid() == userId
        || (resource.data.get('authUid', '') == uid())
        || isAdmin()
        || isStaff()
        || resource.data.role in ['admin', 'teacher']
        || (isParent() && userId in userData().get('childrenIds', []))
        || ((isTeacher() || isStaff()) && resource.data.role in ['student', 'parent'])
      );

      // Robust creation rule for new users
      allow create: if isSignedIn() && uid() == userId && (
          request.resource.data.role in ['admin', 'teacher', 'staff', 'student', 'parent', 'guest']
      );

      allow update: if
        isSuperAdmin()
        || hasPermission('manage-users', 'full')
        || (
          // Fee Management: Allow walletBalance updates when reverting payments
          canManageFees()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
        )
        || (
          // Feeding/Bus/Extra Classes/Sales: Allow dailyArrears updates for teachers with permissions
          // Also allow users delegated full 'manage-users' permission to perform dailyArrears updates
          (canManageFeeding() || canRecordBusFee() || canManageExtraClasses() || canManageSales() || getPermission('manage-users') == 'full')
          && (isAdmin() || (isTeacher() && isClassTeacher(resource.data.classId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyArrears'])
        )
        || (
          // Explicit teacher-permission check: allow teachers with edit/full permissions on the relevant screens
          isTeacher() && (
            getPermission('feeding') in ['full', 'edit'] ||
            getPermission('record-bus-fee') in ['full', 'edit'] ||
            getPermission('record-extra-classes') in ['full', 'edit'] ||
            getPermission('manage-sales') in ['full', 'edit']
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyArrears'])
        )
        || (
          // Staff Payroll: Allow salary updates if the user has payroll permissions
          canManagePayroll()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salary'])
        )
        || (
          isSignedIn() && (uid() == userId || (resource.data.get('authUid', '') == uid()))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'adminRole', 'uid', 'isAnonymous', 'createdAt', 'permissions'
          ])
        )
        || (
          (isTeacher() || isAdmin()) && resource.data.role == 'student'
          && isClassTeacher(resource.data.classId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'adminRole', 'uid', 'isAnonymous', 'createdAt', 'permissions'
          ])
        )
        || (
          // Allow parents to link themselves to students (Max 2 parents)
          isSignedIn() && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids'])
          && uid() in request.resource.data.parentUids
          && (!('parentUids' in resource.data) || resource.data.parentUids.size() < 2)
        );

      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.status == 'pending_activation');
    }

    /* ===============================
       ADMIN ROLES UNIQUENESS
    =============================== */
    match /adminRoles/{roleName} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.roleName == roleName
        && !exists(/databases/$(database)/documents/adminRoles/$(roleName));
      allow update, delete: if isSuperAdmin();
    }

    /* ===============================
       FINANCE
    =============================== */

    match /studentFeeRecords/{id} {
      allow read: if canViewFees()
        || canViewSales()
        || (isParent() && resource.data.studentUid in userData().get('childrenIds', []))
        || (isStudent() && resource.data.studentUid == uid())
        || (isTeacher() && isClassTeacher(resource.data.classId));
      allow write: if canManageFees() || canManageSales()
        || getPermission('manage-users') == 'full'
        || (isTeacher() && (
          (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
          (resource != null && isClassTeacher(resource.data.classId))
        ) && (
          (request.resource != null && request.resource.data.adminUid == uid()) ||
          (resource != null && resource.data.adminUid == uid()) ||
          getPermission('feeding') in ['full', 'edit'] ||
          getPermission('record-bus-fee') in ['full', 'edit'] ||
          getPermission('record-extra-classes') in ['full', 'edit'] ||
          getPermission('manage-sales') in ['full', 'edit']
        ));
    }

    match /feePayments/{id} {
      allow read: if canViewFees()
        || (
          (canViewFeeding() || canViewBusFee() || canViewExtraClasses() || canViewSales())
          && (isAdmin() || (isTeacher() && isClassTeacher(resource.data.classId)))
        )
        || (isParent() && resource.data.studentUid in userData().get('childrenIds', []))
        || (isStudent() && resource.data.studentUid == uid());
      allow write: if canManageFees() || canManageSales() || getPermission('manage-users') == 'full'
        || (
          (canManageFeeding() || canRecordBusFee() || canManageExtraClasses() || canManageSales())
          && (isAdmin() || (isTeacher() && (
            (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
            (resource != null && isClassTeacher(resource.data.classId))
          )))
          && (request.resource == null || request.resource.data.amount is number)
        )
        || (isTeacher() && (
          (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
          (resource != null && isClassTeacher(resource.data.classId))
        ) && (
          (request.resource != null && request.resource.data.adminUid == uid()) ||
          (resource != null && resource.data.adminUid == uid())
        ) && (request.resource == null || request.resource.data.amount is number));
    }

    match /expenditures/{id} {
      allow read: if canViewExpenditure();
      allow create: if isSuperAdmin() || (canManageExpenditure() &&
        request.resource.data.status == 'open' &&
        request.resource.data.amount > 0);
      allow update: if isSuperAdmin() || (canManageExpenditure() &&
        (resource.data.status == 'open' || request.resource.data.status == 'closed'));
      allow delete: if isSuperAdmin();
    }

    /* ===============================
       TEACHER & STUDENT NOTES
    =============================== */
    match /teacher_notes/{noteId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /student_notes/{noteId} {
      allow read, write: if isSignedIn() && (isStudent() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    /* ===============================
       TEACHING & LEARNING MATERIALS (TLM)
    =============================== */
    match /tlms/{tlmId} {
      allow read, write: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    /* ===============================
       OTHER COLLECTIONS
    =============================== */

    match /signupCodes/{codeId} {
      // allow unauthenticated read for verification during signup
      allow read: if true;
      allow create, delete: if canGenerateCodes() || canGenerateCode() || isSuperAdmin();
      allow update: if isSuperAdmin() || (isSignedIn()
        && (!('used' in resource.data) || resource.data.used == false)
        && request.resource.data.used == true
        && request.resource.data.usedBy == uid());
    }

    match /news/{id} {
      allow read: if true;
      allow write: if canManageNews() || canCreateNews();
    }

    match /newscategories/{id} {
      allow read: if true;
      allow write: if canManageNews();
    }

    match /school_settings/{settingId} {
      allow read: if true;
      allow write: if canManageSettings() || isAdmin();
    }

    match /timetables/{classId} {
      allow read: if isSignedIn();
      allow write: if canManageTimetables() || isAdmin() || isClassTeacher(classId);
    }

    /* ===============================
       DIRECT MESSAGES COLLECTION & SUBCOLLECTION
    =============================== */
    match /directMessages/{chatId} {
      function isParticipant() {
        return isSignedIn()
          && (chatId.matches('^' + uid() + '_.*|.*_' + uid() + '$'));
      }

      allow read: if isAdmin() || isParticipant();

      match /messages/{messageId} {
        allow read: if isAdmin() || isParticipant();

        allow create: if
          isAdmin()
          || (
            isParticipant()
            && request.resource.data.senderId == uid()
            && request.resource.data.createdAt is timestamp
          );

        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       CLASSES COLLECTION
    =============================== */
    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ===============================
       ACADEMIC CALENDAR
    =============================== */
    match /academic_calendar/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.visibility == 'all' ||
        (userData().role == 'teacher' && resource.data.visibility == 'teachers') ||
        ((userData().role == 'parent' || userData().role == 'student') && resource.data.visibility == 'parents')
      );
      allow create, update, delete: if canManageAcademicCalendar() || isAdmin() || isEventOrganiser();
    }

    /* ===============================
       CHATS COLLECTION (Admin-Parent)
    =============================== */
    match /chats/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    /* ===============================
       PERSONAL TIMETABLES
    =============================== */
    match /personal_timetables/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /* ===============================
       SUBJECTS COLLECTION
    =============================== */
    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       ATTENDANCE COLLECTION
    =============================== */
    match /attendance/{id} {
      function getClassIdFromAttendanceId(attendanceId) {
        return attendanceId.split('_')[0];
      }

      allow read: if
        canViewAttendance() ||
        isAdmin() ||
        (isTeacher() && (resource.data.classId in userData().classes || getClassIdFromAttendanceId(id) in userData().classes))
        || (isStudent() && (resource.data.classId == userData().classId || getClassIdFromAttendanceId(id) == userData().classId))
        || (isParent() && ('students' in resource.data) && resource.data.students.keys().hasAny(userData().childrenIds));

      allow write: if canManageAttendance() || isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageAttendance() || isAdmin();
    }

    /* ===============================
       BEHAVIORAL RECORDS
    =============================== */
    match /behavioralRecords/{id} {
      allow read: if canViewBehavioralRecords() || isAdmin() || (isTeacher() && resource.data.classId in userData().classes);
      allow write: if canManageBehavioralRecords() || isAdmin() || (isTeacher() && isClassTeacher(request.resource.data.classId));
      allow delete: if canManageBehavioralRecords() || isAdmin();
    }

    /* ===============================
       ASSIGNMENTS COLLECTION
    =============================== */
    match /assignments/{id} {
      allow read: if canViewAssignments() || isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || (isStudent() && resource.data.classId == userData().classId) || isParent();
      allow create, update: if canManageAssignments() || (isTeacher() && request.resource.data.teacherId == uid());
      allow delete: if canManageAssignments() || isAdmin();
    }

    /* ===============================
       SUBMISSIONS COLLECTION
    =============================== */
    match /submissions/{submissionId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == uid()) || (isParent() && resource.data.studentId in userData().childrenIds && resource.data.marked == true);
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isAdmin() || (isTeacher() && request.resource.data.diff(resource.data).changedKeys().hasOnly(['marks', 'marked', 'feedback', 'markedAt', 'questionScores']));
      allow delete: if isAdmin();
    }

    /* ===============================
       NOTIFICATIONS COLLECTION
    =============================== */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientId == uid());
      allow create: if isAdmin() || isTeacher();
      allow update: if uid() == resource.data.recipientId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || uid() == resource.data.recipientId;
    }

    /* ===============================
       ACTIVITY LOGS
    =============================== */
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    /* ===============================
       GALLERY & METADATA
    =============================== */
    match /{collection}/{id} {
      allow read: if collection in ['gallery', 'gallery_metadata'];
      allow write: if collection in ['gallery', 'gallery_metadata'] && (canManageGallery() || isAdmin());
    }

    /* ===============================
       ACADEMIC YEARS
    =============================== */
    match /academicYears/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===============================
       STUDENT GROUPS & MESSAGES
    =============================== */
    match /studentGroups/{groupId} {
      allow read: if canViewStudentGroups() || isAdmin() || (isTeacher() && (resource.data.teacherId == uid() || (('staffIds' in resource.data) && uid() in resource.data.staffIds))) || (isStudent() && uid() in resource.data.studentIds) || (isParent() && userData().childrenIds.hasAny(resource.data.studentIds));
      allow create: if canManageStudentGroups() || (isTeacher() && request.resource.data.teacherId == uid());
      allow update: if canManageStudentGroups() || (isTeacher() && resource.data.teacherId == uid());
      allow delete: if canManageStudentGroups() || isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      match /messages/{messageId} {
        function isGroupMember() {
          let group = get(/databases/$(database)/documents/studentGroups/$(groupId)).data;
          return isAdmin() || group.teacherId == uid() || (('staffIds' in group) && uid() in group.staffIds) || uid() in group.studentIds;
        }
        allow read: if isSignedIn() && isGroupMember();
        allow create: if isSignedIn() && isGroupMember() && request.resource.data.senderId == uid();
      }
    }

    /* ===============================
       GUEST TICKETS & MESSAGES
    =============================== */
    match /guestTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if canViewGuestChat() || isAdmin() || (isSignedIn() && resource.data.guestUid == uid());
      allow update, delete: if canManageGuestChat() || isAdmin();

      match /messages/{messageId} {
        allow read, create: if canViewGuestChat() || isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/guestTickets/$(ticketId)).data.guestUid == uid());
        allow update, delete: if canManageGuestChat() || isAdmin();
      }
    }

    /* ===============================
       FAQS
    =============================== */
    match /faqs/{key} {
      allow read: if true;
      allow write: if canManageFAQ() || isAdmin();
    }

    /* ===============================
       SCORES & REPORTS
    =============================== */
    match /scores/{scoreId} {
      allow read: if canViewScores() || isAdmin() || (isTeacher() && resource.data.classId in userData().classes) || (isStudent() && uid() == resource.data.studentId) || (isParent() && resource.data.studentId in userData().childrenIds);
      allow write: if canManageScores() || isAdmin() || (isTeacher() && request.resource.data.classId in userData().classes);
      allow delete: if canManageScores() || isAdmin();
    }

    match /student-reports/{reportId} {
      allow read: if canViewScores() || isAdmin() || (isTeacher() && resource.data.classId in userData().classes) || (isStudent() && uid() == resource.data.studentId) || (isParent() && resource.data.studentId in userData().childrenIds);
      allow write: if canManageScores() || isAdmin() || (isTeacher() && request.resource.data.classId in userData().classes);
      allow delete: if canManageScores() || isAdmin();
    }

    /* ===============================
       ACADEMIC RECORDS
    =============================== */
    match /academicRecords/{recordId} {
      allow read: if canViewAcademicRecords() || isAdmin() || (isTeacher() && resource.data.classId in userData().classes) || (isParent() && resource.data.status == 'approved' && (!('studentIds' in resource.data) || resource.data.studentIds.hasAny(userData().childrenIds)));
      allow write: if canManageAcademicRecords() || (isSignedIn() && isTeacher() && (request.resource.data.classId in userData().classes) && ((!request.resource.data.containsBehavioralData) || isClassTeacher(request.resource.data.classId)));
    }

    /* ===============================
       METADATA
    =============================== */
    match /metadata/schoolStats {
      allow read, write: if false;
    }

    /* ===============================
       AI & PEDAGOGY COLLECTIONS
    =============================== */
    match /ai_generations/{id} {
      // Teachers can read their own usage and log new generations
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.uid == uid()) && (request.resource == null || request.resource.data.uid == uid());
    }

    match /ai_searches/{id} {
      // Users can log their searches and read their history
      allow read, create: if isSignedIn() && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    match /pedagogy_vault/{id} {
      // Teachers can save and read their own lesson plans
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());

      // Students can read weekly plans for their class
      allow read: if isStudent() && resource.data.classLevel == userData().classId;

      // Allow updates if the teacher is editing their own saved plan
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    /* ===============================
       NON-TEACHING STAFF
       Used for tracking non-teaching staff (drivers, cooks, security, etc.)
       =============================== */
    match /nonTeachingStaff/{staffId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    /* ===============================
       DAILY FINANCIALS
    =============================== */
    match /dailyFinancials/{id} {
      allow read: if canViewFeeding() || canViewBusFee() || canViewExtraClasses() || isAdmin()
        || (isParent() && (id.split('_')[0] in userData().get('childrenIds', []) || (resource != null && resource.data.studentUid in userData().get('childrenIds', []))))
        || (isStudent() && (id.split('_')[0] == uid() || (resource != null && resource.data.studentUid == uid())));

      allow create: if isAdmin() || (
        (isTeacher() || isStaff()) && (
          (request.resource.data.get('feedingPaid', false) == false && request.resource.data.get('feedingFee', 0) == 0 || canManageFeeding()) &&
          (request.resource.data.get('busPaid', false) == false && request.resource.data.get('busFee', 0) == 0 || canRecordBusFee()) &&
          (request.resource.data.get('extraPaid', false) == false && request.resource.data.get('extraClassesFee', 0) == 0 || canManageExtraClasses())
        )
      );

      allow update: if isAdmin() || (
        (isTeacher() || isStaff()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'feedingPaid', 'feedingCollector', 'feedingFee',
          'busPaid', 'busCollector', 'busFee',
          'extraPaid', 'extraCollector', 'extraClassesFee',
          'total', 'disbursedAt', 'disbursedBy',
          'updatedAt', 'date', 'studentUid', 'studentName', 'classId', 'className',
          'recordedBy', 'recordedByUid', 'createdAt', 'otherFees', 'otherFeesDescription',
          'feedingPaidAt', 'busPaidAt', 'extraPaidAt',
          'extraPaidAt', 'extraCollector'
        ]) && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedingPaid', 'feedingCollector', 'feedingFee']) || canManageFeeding()) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['busPaid', 'busCollector', 'busFee']) || canRecordBusFee()) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['extraPaid', 'extraCollector', 'extraClassesFee', 'disbursedAt', 'disbursedBy', 'extraPaidAt']) || canManageExtraClasses() || (
            isTeacher() && (
              (request.resource != null && isClassTeacher(request.resource.data.classId)) ||
              (resource != null && isClassTeacher(resource.data.classId))
            ) && (
              getPermission('record-extra-classes') in ['full', 'edit'] ||
              getPermission('feeding') in ['full', 'edit'] ||
              getPermission('record-bus-fee') in ['full', 'edit']
            )
          ))
        )
      );

      allow delete: if isAdmin();
    }

    /* ===============================
       FALLBACK & CATCH-ALL
       =============================== */
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}

