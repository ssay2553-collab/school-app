rules_version = '2';

/* =========================================================
   FIRESTORE RULES - EduEaz
========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===============================
       AUTH HELPERS
    =============================== */
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid()))
        : null;
    }

    function userData() {
      let doc = userDoc();
      return doc != null ? doc.data : null;
    }

    /* ===============================
       ROLE & PERMISSION CHECKS
    =============================== */

    function getRole() {
      let data = userData();
      return data == null ? null : (
        ('role' in data) ? data.role : (
          ('profile' in data && 'role' in data.profile) ? data.profile.role : null
        )
      );
    }

    function getDocRole(data) {
      let r = (data != null && 'role' in data) ? data.role : (
        (data != null && 'profile' in data && 'role' in data.profile) ? data.profile.role : null
      );
      return r != null ? r.lower() : "";
    }

    function isAdmin() {
      let data = userData();
      let role = getRole();
      let lowerRole = role != null ? role.lower() : "";
      let aRole = (data != null && 'adminRole' in data) ? data.adminRole : null;
      return lowerRole == "admin" || lowerRole == "superadmin" || lowerRole == "super admin" || aRole != null;
    }

    function isSuperAdmin() {
      let data = userData();
      let role = getRole();
      let lowerRole = role != null ? role.lower() : "";
      let aRole = (data != null && 'adminRole' in data) ? data.adminRole : null;
      let lowerARole = aRole != null ? aRole.lower() : "";

      let superRoles = [
        "proprietor", "manager", "headmaster", "director", "superadmin", "super admin"
      ];

      return lowerRole == "superadmin" || lowerRole == "super admin" || (
        (lowerRole == "admin" || lowerRole == "superadmin" || lowerRole == "super admin") &&
        (lowerARole in superRoles)
      );
    }

    function getPermission(screen) {
      let data = userData();
      return data != null
        && ("permissions" in data)
        && (screen in data.permissions)
        ? data.permissions[screen]
        : "deny";
    }

    function hasPermission(screen, level) {
      let role = getRole();
      let lowerRole = role != null ? role.lower() : "";

      // Teachers are strictly forbidden from tuition management
      let isRestricted = (lowerRole == "teacher" && screen == "manage-fees");

      let isAuthorizedRole = lowerRole == "admin" || lowerRole == "teacher" || lowerRole == "staff" || lowerRole == "superadmin" || lowerRole == "super admin";
      return isAuthorizedRole && !isRestricted &&
        (
          isSuperAdmin() ||
          hasScreenPermission(screen, level)
        );
    }

    function hasScreenPermission(screen, level) {
      let p = getPermission(screen);
      return
        (p == "full") ||
        (p == "edit" && (level == "edit" || level == "view")) ||
        (p == "view" && level == "view");
    }

    function isTeacher() {
      let r = getDocRole(userData());
      return r == 'teacher' || r == 'admin' || isAdmin();
    }

    function isStudent() {
      return getDocRole(userData()) == 'student';
    }

    function isParent() {
      return getDocRole(userData()) == 'parent';
    }

    function isClassTeacher(classId) {
      let data = userData();
      let teacherClasses = (data != null && 'classes' in data && data.classes is list) ? data.classes : [];
      let mainClass = data == null ? null : (
        ('classTeacherOf' in data) ? data.classTeacherOf : (
          ('profile' in data && 'classTeacherOf' in data.profile) ? data.profile.classTeacherOf : null
        )
      );

      return isSignedIn() && isTeacher() && data != null && classId != null && classId != "" && (
        mainClass == classId ||
        (classId in teacherClasses) ||
        (exists(/databases/$(database)/documents/classes/$(classId)) && get(/databases/$(database)/documents/classes/$(classId)).data.classTeacherId == uid())
      );
    }

    function getStudentClassId(docData) {
      return (docData != null && 'classId' in docData) ? docData.classId : (
        (docData != null && 'profile' in docData && 'classId' in docData.profile) ? docData.profile.classId : null
      );
    }

    function canCreateNews() {
      let data = userData();
      return isAdmin() || (isTeacher() && data != null && 'canCreateNews' in data && data.canCreateNews == true);
    }

    function canGenerateCode() {
      return isAdmin() || isTeacher();
    }

    function isEventOrganiser() {
      return isTeacher();
    }

    /* =========================================================================
       USERS COLLECTION
    ========================================================================= */

    match /users/{userId} {
      allow read: if (isSignedIn() && (
        isAdmin()
        || uid() == userId
        || (isTeacher() && getDocRole(resource.data) == 'student')
        || (isParent() && getDocRole(resource.data) == 'teacher')
        || (isParent() && userId in userData().childrenIds)
        || (isTeacher() && getDocRole(resource.data) == 'parent')
      )) || (
        (
          resource.data.status == 'pending_activation'
          || 'signupCode' in resource.data
          || 'parentLinkCode' in resource.data
        )
        && (request.method == 'get' || request.query.limit <= 1)
      );

      allow create: if isSignedIn() && uid() == userId && (
          request.resource.data.role in ['admin', 'teacher', 'student', 'parent', 'guest']
      );

      allow update: if
        isSuperAdmin()
        || hasPermission('manage-users', 'full')
        || (
          isSignedIn() && uid() == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'adminRole', 'uid', 'isAnonymous', 'createdAt', 'permissions'
          ])
        )
        || (
          (hasPermission('manage-sales', 'edit') || hasPermission('manage-fees', 'edit') || hasPermission('feeding', 'edit') || hasPermission('record-bus-fee', 'edit') || hasPermission('record-class-fee', 'edit') || hasPermission('record-extra-classes', 'edit') || isClassTeacher(getStudentClassId(resource.data)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance', 'schoolId'])
        )
        || (
          isTeacher() &&
          getDocRole(resource.data) == 'student'
          && isClassTeacher(getStudentClassId(resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'dateOfBirth'])
        )
        || (
          isTeacher() &&
          getDocRole(resource.data) == 'student'
          && isClassTeacher(getStudentClassId(resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId'])
        )
        || (
          isSignedIn() && getDocRole(resource.data) == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids'])
          && uid() in request.resource.data.parentUids
          && (!('parentUids' in resource.data) || resource.data.parentUids.size() < 2)
        );

      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.status == 'pending_activation');
    }

    match /adminRoles/{roleName} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.roleName == roleName
        && !exists(/databases/$(database)/documents/adminRoles/$(roleName));
      allow update, delete: if isSuperAdmin();
    }

    /* ===============================
       FINANCE & PAYROLL
    =============================== */

    match /studentFeeRecords/{id} {
      allow read: if hasPermission('manage-fees', 'view')
        || hasPermission('manage-sales', 'view')
        || (isParent() && resource.data.studentUid in userData().childrenIds);
      allow create, update: if isSuperAdmin() || hasPermission('manage-fees', 'edit')
        || hasPermission('manage-sales', 'edit');
      allow delete: if isSuperAdmin();
    }

    match /feePayments/{id} {
      allow read: if hasPermission('manage-fees', 'view')
        || hasPermission('manage-sales', 'view')
        || (hasPermission('feeding', 'view') && resource.data.type == 'feeding')
        || (hasPermission('record-bus-fee', 'view') && resource.data.type == 'bus')
        || (hasPermission('record-class-fee', 'view') && resource.data.type == 'extra')
        || (hasPermission('record-extra-classes', 'view') && resource.data.type == 'extra')
        || (hasPermission('manage-sales', 'view') && resource.data.type == 'other')
        || (isParent() && resource.data.studentUid in userData().childrenIds);

      allow create: if hasPermission('manage-fees', 'edit')
        || hasPermission('manage-sales', 'edit')
        || (hasPermission('feeding', 'edit') && request.resource.data.type == 'feeding')
        || (hasPermission('record-bus-fee', 'edit') && request.resource.data.type == 'bus')
        || (hasPermission('record-class-fee', 'edit') && request.resource.data.type == 'extra')
        || (hasPermission('record-extra-classes', 'edit') && request.resource.data.type == 'extra')
        || (hasPermission('manage-sales', 'edit') && request.resource.data.type == 'other');

      allow update, delete: if isSuperAdmin();
    }

    match /expenditures/{id} {
      allow read: if hasPermission('expenditure', 'view');
      allow create: if hasPermission('expenditure', 'edit') &&
        request.resource.data.status == 'open' &&
        request.resource.data.amount > 0;
      allow update: if hasPermission('expenditure', 'edit') &&
        (resource.data.status == 'open' || request.resource.data.status == 'closed');
      allow delete: if isSuperAdmin();
    }

   match /nonTeachingStaff/{staffId} {
      allow read: if hasPermission('staff-payroll', 'view') || hasPermission('staff-payroll', 'edit');
      allow create, update: if hasPermission('staff-payroll', 'edit');
      allow delete: if isSuperAdmin();
    }

   match /payroll/{id} {
      allow read: if hasPermission('staff-payroll', 'view') || hasPermission('staff-payroll', 'edit');
      allow create, update: if hasPermission('staff-payroll', 'edit');
      allow delete: if isSuperAdmin();
    }

    /* ===============================
       SCHOOL SETTINGS & ACADEMICS
    =============================== */

    match /signupCodes/{codeId} {
      allow read: if true;
      allow create, delete: if canGenerateCode();
      allow update: if isSignedIn()
        && (!('used' in resource.data) || resource.data.used == false)
        && request.resource.data.used == true
        && request.resource.data.usedBy == uid();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if canCreateNews();
    }

    match /school_settings/{settingId} {
      allow read: if isSignedIn();
      allow update: if isSuperAdmin()
        || (settingId == "academic_config" && (
             hasPermission("edit-feeding-rate", "edit") ||
             hasPermission("edit-class-fee-rate", "edit") ||
             hasPermission("edit-extra-classes-rate", "edit")
           ))
        || (settingId == "bus_rates" && hasPermission("edit-bus-rate", "edit"));
      allow create, delete: if isSuperAdmin();
    }

    match /timetables/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isClassTeacher(classId);
    }

    match /classes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academic_calendar/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.visibility == 'all' ||
        (isTeacher() && resource.data.visibility == 'teachers') ||
        ((isParent() || isStudent()) && resource.data.visibility == 'parents')
      );
      allow create, update, delete: if isAdmin() || isEventOrganiser();
    }

    match /academicYears/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /curriculum/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    /* ===============================
       MESSAGING & COMMUNICATION
    =============================== */
    match /directMessages/{chatId} {
      function isParticipant() {
        return isSignedIn() && (chatId.matches('^' + uid() + '_.*|.*_' + uid() + '$'));
      }
      allow read: if isAdmin() || isParticipant() || isTeacher();

      match /messages/{messageId} {
        allow read: if isAdmin() || isParticipant() || isTeacher();
        allow create: if isAdmin() || isTeacher() || (
            isParticipant() && request.resource.data.senderId == uid() && request.resource.data.createdAt is timestamp
          );
        allow update, delete: if isAdmin();
      }
    }

    match /chats/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    match /studentGroups/{groupId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || (isStudent() && uid() in resource.data.studentIds) || (isParent() && userData().childrenIds.hasAny(resource.data.studentIds));
      allow create: if isTeacher() && request.resource.data.teacherId == uid();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      match /messages/{messageId} {
        function isGroupMember() {
          let group = get(/databases/$(database)/documents/studentGroups/$(groupId)).data;
          return isAdmin() || group.teacherId == uid() || uid() in group.studentIds;
        }
        allow read: if isSignedIn() && isGroupMember();
        allow create: if isSignedIn() && isGroupMember() && request.resource.data.senderId == uid();
      }
    }

    match /guestTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.guestUid == uid());
      allow update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/guestTickets/$(ticketId)).data.guestUid == uid());
        allow update, delete: if isAdmin();
      }
    }

    /* ===============================
       STUDENT RECORDS & ACADEMICS
    =============================== */
    match /attendance/{id} {
      allow read: if isAdmin()
        || (isTeacher() && (isClassTeacher(resource.data.classId) || isClassTeacher(id.split('_')[0])))
        || hasPermission('feeding', 'view')
        || hasPermission('record-bus-fee', 'view')
        || hasPermission('record-class-fee', 'view')
        || hasPermission('record-extra-classes', 'view')
        || hasPermission('manage-sales', 'view')
        || (isStudent() && resource.data.classId == userData().classId)
        || (isParent() && exists(/databases/$(database)/documents/users/$(uid())) && (resource.data.students.keys().hasAny(userData().childrenIds)));
      allow create, update: if isAdmin() || (
        isTeacher() &&
        isClassTeacher(request.resource.data.classId) &&
        // Ghana Time (GMT/UTC): Allow marking only between 6:00 AM and 10:00 AM
        request.time.hour() >= 6 && request.time.hour() < 10
      );
      allow delete: if isSuperAdmin();
    }

    match /behavioralRecords/{id} {
      allow read: if isAdmin() || isTeacher() || isStudent() || isParent();
      allow write: if isAdmin() || (isTeacher() && isClassTeacher(getStudentClassId(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == uid()) || isStudent() || isParent();
      allow create, update: if isTeacher() && request.resource.data.teacherId == uid();
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == uid());
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isAdmin() || (isTeacher() && request.resource.data.diff(resource.data).changedKeys().hasOnly(['marks', 'marked', 'feedback', 'markedAt', 'questionScores']));
      allow delete: if isAdmin();
    }

    match /scores/{scoreId} {
      allow read: if isAdmin() || (isTeacher() && isClassTeacher(getStudentClassId(resource.data))) || (isStudent() && uid() == resource.data.studentId) || (isParent() && resource.data.studentId in userData().childrenIds);
      allow write: if isAdmin() || (isTeacher() && isClassTeacher(getStudentClassId(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /student-reports/{reportId} {
      allow read: if isAdmin() || (isTeacher() && isClassTeacher(getStudentClassId(resource.data))) || (isStudent() && uid() == resource.data.studentId) || (isParent() && resource.data.studentId in userData().childrenIds);
      allow write: if isAdmin() || (isTeacher() && isClassTeacher(getStudentClassId(request.resource.data)));
      allow delete: if isAdmin();
    }

    match /academicRecords/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isTeacher() && ((!request.resource.data.containsBehavioralData) || isClassTeacher(getStudentClassId(request.resource.data)));
    }

    /* ===============================
       OTHER COLLECTIONS
    =============================== */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientId == uid());
      allow create: if isAdmin() || isTeacher();
      allow update: if uid() == resource.data.recipientId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || uid() == resource.data.recipientId;
    }

    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow create, update: if hasPermission('gallery', 'edit');
      allow delete: if hasPermission('gallery', 'full');
    }

    match /gallery_metadata/{id} {
      allow read: if true;
      allow create, update: if hasPermission('gallery', 'edit');
      allow delete: if hasPermission('gallery', 'full');
    }

    match /newscategories/{id} { allow read: if true; }
    match /faqs/{key} { allow read: if true; allow write: if isAdmin(); }
    match /personal_timetables/{userId} { allow read, write: if isSignedIn() && uid() == userId; }
    match /subjects/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /metadata/schoolStats { allow read, write: if false; }

    /* ===============================
       AI & PEDAGOGY COLLECTIONS
    =============================== */
    match /ai_generations/{id} {
      allow read: if isSignedIn() && (isTeacher() || isAdmin()) && resource.data.userId == uid();
      allow create: if isSignedIn() && (isTeacher() || isAdmin()) && request.resource.data.userId == uid() && request.resource.data.subject in userData().subjects;
    }

    match /ai_searches/{id} {
      allow read, create: if isSignedIn() && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
    }

    match /pedagogy_vault/{id} {
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
      allow update, delete: if isSignedIn() && resource.data.userId == uid();
    }

    match /tlms/{id} {
      allow read, create: if isSignedIn() && (isTeacher() || isAdmin()) && (resource == null || resource.data.userId == uid()) && (request.resource == null || request.resource.data.userId == uid());
      allow update, delete: if isSignedIn() && resource.data.userId == uid();
    }

    /* ===============================
       FALLBACK & CATCH-ALL
    =============================== */
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
